                        <legend>सूचना प्रविधि अधिकृत</legend>
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                @Html.LabelFor(model => model.ITName)

                                @Html.EditorFor(model => model.ITName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.ITName, "", new { @class = "text-danger" })
                            </div>

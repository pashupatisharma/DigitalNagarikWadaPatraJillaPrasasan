                                @Html.ValidationMessageFor(model => model.AdkshyaMessage, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                @Html.LabelFor(model => model.AdkshyaPhoto)

                                @Html.FileFor(model => model.Photo1, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Photo1, "", new { @class = "text-danger" })
                                @Html.HiddenFor(m => m.AdkshyaPhoto)
                            </div>

                        </div>

                    </fieldset>
                    <div></div><br />
                    <fieldset>
                        <legend>पालिका उपप्रमुख</legend>

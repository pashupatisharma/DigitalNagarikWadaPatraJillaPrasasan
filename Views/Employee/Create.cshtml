                        <legend>पालिका प्रमुख</legend>
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                @Html.LabelFor(model => model.AdkshyaName)

                                @Html.EditorFor(model => model.AdkshyaName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.AdkshyaName, "", new { @class = "text-danger" })
                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                @Html.LabelFor(model => model.AdkshyaContactNo)


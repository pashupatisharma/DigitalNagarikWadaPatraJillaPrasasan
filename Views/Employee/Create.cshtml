@model HelpDesk.Models.Employee
@using HelpDesk.Helpers;
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("Create", "Employee", FormMethod.Post, new { id = "form0", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <hr />

                <div class="card-body">

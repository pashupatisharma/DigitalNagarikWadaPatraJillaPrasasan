                            </div>

                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                                @Html.LabelFor(model => model.UpaAdkshyaMessage)

                                @Html.EditorFor(model => model.UpaAdkshyaMessage, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.UpaAdkshyaMessage, "", new { @class = "text-danger" })

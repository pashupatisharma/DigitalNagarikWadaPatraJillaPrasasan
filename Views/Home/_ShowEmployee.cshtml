@model HelpDesk.Models.HomePageViewModel

<style>
    /* =========================================================
       EMPLOYEE DETAIL
       ========================================================= */

    .employee-detail-view {
        width: 100%;
        height: 100%;
        min-height: 0;
        padding: 20px;
        box-sizing: border-box;
        font-family: "Noto Sans Devanagari", "Kalimati", "Mangal", Arial, sans-serif;
    }

    .employee-info-card {
        width: 100%;
        min-height: 280px;
        display: flex;
        align-items: center;
        padding: 25px 35px;
        box-sizing: border-box;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #c9a227;
        border-radius: 10px;
        box-shadow: 0 5px 18px rgba(15, 31, 61, 0.10);
    }

    /* ---------------------------------------------------------
       IMAGE
       --------------------------------------------------------- */

    .employee-image-area {
        width: 230px;
        min-width: 230px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .emp-image {
        width: 200px;
        height: 200px;
        object-fit: cover;
        border: 3px solid #ffffff;
        outline: 2px solid #c9a227;
        border-radius: 50%;
        background: #f8fafc;
        box-shadow: 0 5px 14px rgba(15, 31, 61, 0.18);
    }

    /* ---------------------------------------------------------
       DETAILS
       --------------------------------------------------------- */

    .employee-detail {
        flex: 1;
        min-width: 0;
        padding-left: 25px;
    }

    .employee-name {
        margin: 0 0 5px 0;
        color: #172554;
        font-family: "Noto Sans Devanagari", "Kalimati", "Mangal", sans-serif;
        font-size: 34px;
        font-weight: 700;
        line-height: 1.4;
    }

    .employee-name-eng {
        color: #64748b;
        font-family: "Times New Roman", "Segoe UI", sans-serif;
        font-size: 21px;
        font-weight: 600;
    }

    .employee-line {
        width: 65px;
        height: 4px;
        margin: 14px 0 20px 0;
        background: #c9a227;
        border-radius: 5px;
    }

    .employee-information {
        margin: 0;
        color: #334155;
        font-family: "Noto Sans Devanagari", "Kalimati", "Mangal", sans-serif;
        font-size: 21px;
        line-height: 1.9;
    }

        .employee-information .label {
            color: #64748b;
            font-weight: 600;
        }

        .employee-information .value {
            color: #172554;
            font-weight: 600;
        }

        .employee-information i {
            width: 25px;
            margin-right: 5px;
            color: #172554;
            text-align: center;
        }

    .employee-contact {
        font-family: "Segoe UI", "Noto Sans Devanagari", sans-serif;
    }

    /* ---------------------------------------------------------
       LARGE DISPLAY
       --------------------------------------------------------- */

    @@media screen and (min-width: 1800px) {

        .employee-detail-view {
            padding: 30px;
        }

        .employee-info-card {
            min-height: 330px;
            padding: 35px 45px;
        }

        .employee-image-area {
            width: 280px;
            min-width: 280px;
        }

        .emp-image {
            width: 240px;
            height: 240px;
        }

        .employee-name {
            font-size: 42px;
        }

        .employee-name-eng {
            font-size: 24px;
        }

        .employee-information {
            font-size: 25px;
        }
    }

    /* ---------------------------------------------------------
       TABLET
       --------------------------------------------------------- */

    @@media screen and (max-width: 900px) {

        .employee-info-card {
            padding: 20px;
        }

        .employee-image-area {
            width: 190px;
            min-width: 190px;
        }

        .emp-image {
            width: 160px;
            height: 160px;
        }

        .employee-detail {
            padding-left: 15px;
        }

        .employee-name {
            font-size: 28px;
        }

        .employee-name-eng {
            font-size: 18px;
        }

        .employee-information {
            font-size: 18px;
        }
    }

    /* ---------------------------------------------------------
       MOBILE
       --------------------------------------------------------- */

    @@media screen and (max-width: 600px) {

        .employee-detail-view {
            padding: 10px;
            overflow-y: auto;
        }

        .employee-info-card {
            flex-direction: column;
            text-align: center;
            padding: 20px 15px;
            border-left: none;
            border-top: 4px solid #c9a227;
        }

        .employee-image-area {
            width: 100%;
            min-width: 0;
            margin-bottom: 15px;
        }

        .emp-image {
            width: 120px;
            height: 120px;
        }

        .employee-detail {
            width: 100%;
            padding-left: 0;
        }

        .employee-name {
            font-size: 24px;
        }

        .employee-name-eng {
            font-size: 17px;
        }

        .employee-line {
            margin-left: auto;
            margin-right: auto;
        }

        .employee-information {
            font-size: 16px;
            line-height: 1.8;
        }
    }
</style>

<div class="employee-detail-view">

   
    <div class="employee-info-card">

        <!-- Employee Image -->
        <div class="employee-image-area">

            @if (!string.IsNullOrWhiteSpace(Model.employeeSetup.Image))
            {
                <img src="@Url.Content("~/EmployeeImage/" + Model.employeeSetup.Image)"
                     class="emp-image"
                     alt="@Model.employeeSetup.EmpName" />
            }
            else
            {
                <img src="@Url.Content("~/Content/images/UserImage.png")"
                     class="emp-image"
                     alt="Employee" />
            }

        </div>


        <!-- Employee Details -->
        <div class="employee-detail">

            <div class="employee-name">
                @Model.employeeSetup.EmpName

                @if (!string.IsNullOrWhiteSpace(Model.employeeSetup.EmpNameEng))
                {
                    <span class="employee-name-eng">
                        [@Model.employeeSetup.EmpNameEng]
                    </span>
                }
            </div>

            <div class="employee-line"></div>

            <div class="employee-information">

                <div>
                    <span class="label">पद:</span>
                    <i class="fa-solid fa-user-tie"></i>
                    <span class="value">
                        @Utility.GetPostNameById(Model.employeeSetup.PostId)
                    </span>
                </div>

                <div>
                    <span class="label">सम्पर्क नम्बर:</span>
                    <i class="fa-solid fa-phone"></i>
                    <span class="value employee-contact">
                        @Model.employeeSetup.Contact
                    </span>
                </div>

                <div>
                    <span class="label">ठेगाना:</span>
                    <i class="fa-solid fa-location-dot"></i>
                    <span class="value">
                        @Model.employeeSetup.Address
                    </span>
                </div>

            </div>

        </div>

    </div>
    

</div>

@model HelpDesk.Models.HomePageViewModel

<style>

    .video-detail {
        width: 100%;
        margin: 0;
        padding: 0;
        background: #000;
        overflow: hidden;
    }

    .video-player-wrapper {
        width: 100%;
        aspect-ratio: 16 / 9;
        margin: 0;
        padding: 0;
        background: #000;
        overflow: hidden;
    }

    .video-detail .player {
        display: block;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        border: none;
        outline: none;
        background: #000;
        object-fit: contain;
    }

    .video-not-available {
        width: 100%;
        aspect-ratio: 16 / 9;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        color: #cbd5e1;
        text-align: center;
    }
</style>


<div id="@Model.video.VideoId"
     class="video-detail">

    @if (Model.video.VideoData != null)
    {
        <div class="video-player-wrapper">

           <video class="player"
                  autoplay
                  muted
                  loop
                  playsinline
                  id="videoPlayer">

               <source src="@Url.Content("~/UploadedVideos/" + Model.video.VideoData)"
                       type="video/mp4" />

               तपाईंको ब्राउजरले भिडियो प्ले गर्न समर्थन गर्दैन।

           </video>

        </div>
    }
    else
    {
        <div class="video-not-available">
            भिडियो उपलब्ध छैन
        </div>
    }

</div>


<script>

    function showalert(id) {

        var currentId = Number(id);

        if (isNaN(currentId)) {
            return;
        }

        var nextVideoId = currentId + 1;

        if (typeof openVideo === "function") {
            openVideo(nextVideoId);
        }
    }


   $(document).ready(function () {

    var video = document.getElementById("videoPlayer");

    if (!video) {
        return;
    }

    video.muted = true;
    video.loop = true;

    var playPromise = video.play();

    if (playPromise !== undefined) {
        playPromise.catch(function () {
            // Browser prevented autoplay.
            // No controls are enabled because the video
            // should remain a clean display-board video.
        });
    }

});

</script>

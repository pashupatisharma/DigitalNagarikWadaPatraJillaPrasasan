<div class="service-home">

    <!-- =====================================================
         MAIN TWO-COLUMN PAGE
         LEFT  = SERVICES
         RIGHT = VIDEO + PEOPLE
         ===================================================== -->

    <div class="service-page-layout">


        <!-- =================================================
             LEFT SECTION
             SERVICE HEADER + SERVICE TABLE
             ================================================= -->

        <div class="service-left-section">


            <!-- =============================================
                 SERVICE HEADER
                 ============================================= -->

            <div class="service-header">

                <div class="service-header-left">

                    <div class="service-title">
                        <i class="fa fa-building"></i>
                        सेवा तथा जानकारी
                    </div>

                    <div class="service-subtitle">
                        नागरिकलाई उपलब्ध सेवा, प्रक्रिया, दस्तुर तथा जिम्मेवार पदाधिकारी
                    </div>

                </div>


                <!-- =========================================
                     DATE / TIME + SEARCH
                     ========================================= -->

                <div class="service-header-right">

                    <div class="service-date-time">

                        <div class="service-date"
                             id="currentDate">
                        </div>

                        <div class="service-time"
                             id="currentTime">
                        </div>

                    </div>


                    <div class="service-search">

                        <input type="text"
                               id="serviceSearch"
                               autocomplete="off"
                               placeholder="सेवा खोज्नुहोस्..." />

                        <span class="service-search-icon">
                            <i class="fa fa-search"></i>
                        </span>

                    </div>

                </div>

            </div>


            <!-- =============================================
                 SERVICE TABLE
                 ============================================= -->

            <div class="service-table-container">

                <div class="service-table-scroll"
                     id="serviceTableScroll">

                    @if (Model != null &&
                         Model.subModule != null &&
                         Model.subModule.List != null &&
                         Model.subModule.List.Any())
                    {
                        <table class="service-table"
                               id="serviceTable">

                            <thead>

                                <tr>

                                    <th class="serial-column">
                                        सि.न.
                                    </th>

                                    <th class="service-name-column">
                                        सेवा सुविधाको नाम
                                    </th>

                                    <th class="process-column">
                                        सेवा लिने प्रक्रिया/चाहिने कागजातहरू
                                    </th>

                                    <th class="fee-column">
                                        लाग्ने सेवा शुल्क तथा दस्तुर
                                    </th>

                                    <th class="time-column">
                                        लाग्ने समय
                                    </th>

                                    <th class="officer-column">
                                        जिम्मेवार पदाधिकारी
                                    </th>

                                </tr>

                            </thead>


                            <tbody id="serviceTableBody">

                                @{
                                    int serialNumber = 1;
                                }

                                @foreach (var service in Model.subModule.List)
                                {
                                    <tr class="service-row"
                                        data-service-index="@serialNumber"
                                        data-service-title="@service.Title">

                                        <!-- =================================
                                             SERIAL NUMBER
                                             ================================= -->

                                        <td class="serial-column">

                                            <span class="serial-number">
                                                @serialNumber
                                            </span>

                                        </td>


                                        <!-- =================================
                                             SERVICE NAME
                                             ================================= -->

                                        <td>

                                            <div class="service-name">
                                                @service.Title
                                            </div>

                                        </td>


                                        <!-- =================================
                                             PROCESS / DOCUMENTS
                                             ================================= -->

                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(service.Process))
                                            {
                                                <div class="service-detail">

                                                    <span class="detail-label">
                                                        सेवा लिने प्रक्रिया:
                                                    </span>

                                                    @Html.Raw(service.Process)

                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(service.DocumentNeeded))
                                            {
                                                <div class="service-detail">

                                                    <span class="detail-label">
                                                        चाहिने कागजात:
                                                    </span>

                                                    @Html.Raw(service.DocumentNeeded)

                                                </div>
                                            }

                                        </td>


                                        <!-- =================================
                                             SERVICE FEE
                                             ================================= -->

                                        <td>

                                            <div class="fee-value">

                                                @if (!string.IsNullOrWhiteSpace(service.DasturNeed))
                                                {
                                                    @service.DasturNeed
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }

                                            </div>

                                        </td>


                                        <!-- =================================
                                             SERVICE TIME
                                             ================================= -->

                                        <td>

                                            <div class="time-value">

                                                @if (!string.IsNullOrWhiteSpace(service.TimeNeed))
                                                {
                                                    @service.TimeNeed
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }

                                            </div>

                                        </td>


                                        <!-- =================================
                                             RESPONSIBLE OFFICER
                                             ================================= -->

                                        <td>

                                            <div class="officer-value">

                                                @if (!string.IsNullOrWhiteSpace(service.ResponsibleOfficer))
                                                {
                                                    @service.ResponsibleOfficer
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }

                                            </div>

                                        </td>

                                    </tr>

                                    serialNumber++;
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <div class="no-service">

                            <div>

                                <i class="fa fa-folder-open fa-2x"></i>

                                <br />
                                <br />

                                हाल कुनै सेवा उपलब्ध छैन।

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- =================================================
             RIGHT SECTION
             VIDEO + REPRESENTATIVES / EMPLOYEES
             ================================================= -->

        <div class="service-right-section">


            <!-- =================================================
                 VIDEO
                 EXISTING SHOWVIDEOS BACKEND ACTION IS USED
                 ================================================= -->

            <div class="video-panel"
                 id="videoPanel">

                @if (Model != null &&
                     Model.video != null)
                {
                    @Html.Action(
                        "ShowVideos",
                        "Home",
                        new
                        {
                            id = Model.video.VideoId
                        })
                }
                else
                {
                    <div class="video-not-available">

                        <i class="fa-solid fa-video-slash fa-2x"></i>

                    </div>
                }

            </div>


            <!-- =================================================
                 PEOPLE / EMPLOYEE SECTION
                 ================================================= -->

            <div class="people-panel">

                <div class="people-header">

                    <div class="people-header-title">
                        <i class="fa fa-users"></i>
                        प्रतिनिधि / कर्मचारीहरु
                    </div>

                    <button type="button"
                            class="people-list-button"
                            id="openPeopleList"
                            title="सबै हेर्नुहोस्">

                        <i class="fa fa-list"></i>

                    </button>

                </div>


                <!-- =============================================
                     CURRENT PERSON
                     ============================================= -->

                <div class="person-display"
                     id="personDisplay">

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     PEOPLE LIST MODAL
     ========================================================= -->

<div class="people-list-modal"
     id="peopleListModal">

    <div class="people-list-dialog">


        <!-- =================================================
             PEOPLE MODAL HEADER
             ================================================= -->

        <div class="people-list-header">

            <div>

                <i class="fa fa-users"></i>

                प्रतिनिधि / कर्मचारीहरुको सूची

            </div>

            <button type="button"
                    class="people-list-close"
                    id="closePeopleList">

                <i class="fa fa-times"></i>

            </button>

        </div>


        <!-- =================================================
             PEOPLE MODAL BODY
             ================================================= -->

        <div class="people-list-body">

            <div class="people-list-grid">


                <!-- =============================================
                     REPRESENTATIVES
                     ============================================= -->

                @if (Model != null &&
                     Model.peopleRepresentative != null &&
                     Model.peopleRepresentative.List != null)
                {
                    foreach (var person in Model.peopleRepresentative.List)
                    {
                        <div class="people-list-item">

                            @{
                                var personImage =
                                    !string.IsNullOrWhiteSpace(person.ImageUrl)
                                        ? person.ImageUrl
                                        : null;
                            }

                            <img src="@personImage"
                                 class="people-list-image"
                                 alt="@person.Name" />

                            <div>

                                <div class="people-list-name">
                                    @person.Name
                                </div>

                                <div class="people-list-post">

                                    @if (person.PostSetup != null)
                                    {
                                        @person.PostSetup.PostTitle
                                    }

                                </div>

                                @if (!string.IsNullOrWhiteSpace(person.Contact))
                                {
                                    <div class="people-list-contact">

                                        <i class="fa fa-phone"></i>

                                        @person.Contact

                                    </div>
                                }

                            </div>

                        </div>
                    }
                }


                <!-- =============================================
                     EMPLOYEES
                     ============================================= -->

                @if (Model != null &&
                     Model.employeeSetup != null &&
                     Model.employeeSetup.Lists != null)
                {
                    foreach (var employee in Model.employeeSetup.Lists)
                    {
                        <div class="people-list-item">

                            @{
                                var employeeImage =
                                    !string.IsNullOrWhiteSpace(employee.ImageUrl)
                                        ? employee.ImageUrl
                                        : null;
                            }

                            <img src="@employeeImage"
                                 class="people-list-image"
                                 alt="@employee.EmpName" />

                            <div>

                                <div class="people-list-name">
                                    @employee.EmpName
                                </div>

                                <div class="people-list-post">

                                    @if (employee.PostSetup != null)
                                    {
                                        @employee.PostSetup.PostTitle
                                    }

                                </div>

                                @if (!string.IsNullOrWhiteSpace(employee.Contact))
                                {
                                    <div class="people-list-contact">

                                        <i class="fa fa-phone"></i>

                                        @employee.Contact

                                    </div>
                                }

                            </div>

                        </div>
                    }
                }

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     SERVICE SEARCH DETAIL POPUP
     SHOWS COMPLETE SERVICE ROW
     ========================================================= -->

<div class="service-detail-modal"
     id="serviceDetailModal">

    <div class="service-detail-dialog">


        <!-- =================================================
             POPUP HEADER
             ================================================= -->

        <div class="service-detail-header">

            <div class="service-detail-header-title"
                 id="serviceDetailTitle">

                सेवा विवरण

            </div>

            <button type="button"
                    class="service-detail-close"
                    id="closeServiceDetail">

                <i class="fa fa-times"></i>

            </button>

        </div>


        <!-- =================================================
             POPUP BODY
             ALL SERVICE INFORMATION IS SHOWN HERE
             ================================================= -->

        <div class="service-detail-body">

            <table class="service-detail-table">

                <tbody>

                    <tr>

                        <th>
                            सि.न.
                        </th>

                        <td id="detailSerial">
                        </td>

                    </tr>

                    <tr>

                        <th>
                            सेवा सुविधाको नाम
                        </th>

                        <td id="detailServiceName">
                        </td>

                    </tr>

                    <tr>

                        <th>
                            सेवा लिने प्रक्रिया
                        </th>

                        <td id="detailProcess">
                        </td>

                    </tr>

                    <tr>

                        <th>
                            चाहिने कागजात
                        </th>

                        <td id="detailDocuments">
                        </td>

                    </tr>

                    <tr>

                        <th>
                            लाग्ने सेवा शुल्क तथा दस्तुर
                        </th>

                        <td id="detailFee">
                        </td>

                    </tr>

                    <tr>

                        <th>
                            लाग्ने समय
                        </th>

                        <td id="detailTime">
                        </td>

                    </tr>

                    <tr>

                        <th>
                            जिम्मेवार पदाधिकारी
                        </th>

                        <td id="detailOfficer">
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {


        /* =====================================================
           DATE AND TIME
           Updates the header clock immediately and every second.
           ===================================================== */

        function updateDateTime() {

            var now = new Date();

            var dateText =
                now.toLocaleDateString(
                    "ne-NP",
                    {
                        year: "numeric",
                        month: "long",
                        day: "numeric"
                    }
                );

            var timeText =
                now.toLocaleTimeString(
                    "ne-NP",
                    {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit",
                        hour12: true
                    }
                );

            var dateElement =
                document.getElementById("currentDate");

            var timeElement =
                document.getElementById("currentTime");

            if (dateElement) {
                dateElement.textContent = dateText;
            }

            if (timeElement) {
                timeElement.textContent = timeText;
            }

        }

        updateDateTime();

        setInterval(updateDateTime, 1000);


        /* =====================================================
           SERVICE TABLE ELEMENTS
           ===================================================== */

        var searchInput =
            document.getElementById("serviceSearch");

        var tableBody =
            document.getElementById("serviceTableBody");

        var tableScroll =
            document.getElementById("serviceTableScroll");


        /* =====================================================
           SERVICE DETAIL POPUP ELEMENTS
           ===================================================== */

        var serviceDetailModal =
            document.getElementById("serviceDetailModal");

        var closeServiceDetail =
            document.getElementById("closeServiceDetail");

        var detailTitle =
            document.getElementById("serviceDetailTitle");

        var detailSerial =
            document.getElementById("detailSerial");

        var detailServiceName =
            document.getElementById("detailServiceName");

        var detailProcess =
            document.getElementById("detailProcess");

        var detailDocuments =
            document.getElementById("detailDocuments");

        var detailFee =
            document.getElementById("detailFee");

        var detailTime =
            document.getElementById("detailTime");

        var detailOfficer =
            document.getElementById("detailOfficer");


        /* =====================================================
           OPEN COMPLETE SERVICE POPUP
           
           The actual TD HTML is copied into the popup.
           Therefore long Process / DocumentNeeded content
           is NOT truncated.
           ===================================================== */

        function openServiceDetails(row) {

            if (!row || !serviceDetailModal) {
                return;
            }

            var cells =
                row.querySelectorAll("td");

            if (cells.length < 6) {
                return;
            }


            /* ---------------------------------------------
               SERIAL
               --------------------------------------------- */

            if (detailSerial) {

                detailSerial.innerHTML =
                    cells[0].innerHTML;

            }


            /* ---------------------------------------------
               SERVICE NAME
               --------------------------------------------- */

            if (detailServiceName) {

                detailServiceName.innerHTML =
                    cells[1].innerHTML;

            }


            /* ---------------------------------------------
               PROCESS
               --------------------------------------------- */

            var processCell =
                cells[2];

            var processHtml = "";
            var documentHtml = "";


            var processDetails =
                processCell.querySelectorAll(
                    ".service-detail"
                );


            processDetails.forEach(function (detail) {

                var label =
                    detail.querySelector(
                        ".detail-label"
                    );

                if (!label) {
                    return;
                }

                var labelText =
                    label.textContent
                        .trim()
                        .replace(/:$/, "");


                var content =
                    detail.cloneNode(true);

                var contentLabel =
                    content.querySelector(
                        ".detail-label"
                    );

                if (contentLabel) {
                    contentLabel.remove();
                }


                if (
                    labelText.indexOf("कागजात") !== -1
                ) {

                    documentHtml +=
                        content.innerHTML;

                }
                else {

                    processHtml +=
                        content.innerHTML;

                }

            });


            /*
             * If there are no structured details,
             * copy the complete cell.
             */

            if (!processHtml &&
                !documentHtml) {

                processHtml =
                    processCell.innerHTML;

            }


            if (detailProcess) {

                detailProcess.innerHTML =
                    processHtml || "-";

            }

            if (detailDocuments) {

                detailDocuments.innerHTML =
                    documentHtml || "-";

            }


            /* ---------------------------------------------
               FEE
               --------------------------------------------- */

            if (detailFee) {

                detailFee.innerHTML =
                    cells[3].innerHTML;

            }


            /* ---------------------------------------------
               TIME
               --------------------------------------------- */

            if (detailTime) {

                detailTime.innerHTML =
                    cells[4].innerHTML;

            }


            /* ---------------------------------------------
               OFFICER
               --------------------------------------------- */

            if (detailOfficer) {

                detailOfficer.innerHTML =
                    cells[5].innerHTML;

            }


            /* ---------------------------------------------
               POPUP TITLE
               --------------------------------------------- */

            if (detailTitle) {

                var serviceName =
                    cells[1].textContent.trim();

                detailTitle.textContent =
                    serviceName ||
                    "सेवा विवरण";

            }


            /*
             * Show popup immediately.
             */

            serviceDetailModal.style.display =
                "flex";

            document.body.style.overflow =
                "hidden";

        }


        /* =====================================================
           CLOSE SERVICE POPUP
           ===================================================== */

        function closeServiceDetails() {

            if (!serviceDetailModal) {
                return;
            }

            serviceDetailModal.style.display =
                "none";

            document.body.style.overflow =
                "";

        }


        if (closeServiceDetail) {

            closeServiceDetail.addEventListener(
                "click",
                closeServiceDetails
            );

        }


        /* =====================================================
           SERVICE SEARCH
           
           - Searches immediately as user types.
           - Clearing search immediately restores all rows.
           - One exact/strong result automatically opens popup.
           - Clicking any visible matching row opens popup.
           ===================================================== */

        if (searchInput && tableBody) {

            searchInput.addEventListener(
                "input",
                function () {

                    var searchText =
                        this.value
                            .toLowerCase()
                            .trim();

                    var rows =
                        tableBody.querySelectorAll(
                            ".service-row"
                        );

                    var matchingRows = [];


                    /* =================================================
                       CLEAR SEARCH
                       ================================================= */

                    if (searchText === "") {

                        rows.forEach(function (row) {

                            row.style.display = "";

                            row.classList.remove(
                                "search-match"
                            );

                        });

                        return;
                    }


                    /* =================================================
                       FIRST PRIORITY:
                       EXACT SERIAL NUMBER MATCH
                       
                       Example:
                       Search "1"  -> serial 1
                       Search "10" -> serial 10
                       Search "25" -> serial 25
            
                       This prevents "1" from automatically opening
                       service 10, 11, 12 etc.
                       ================================================= */

                    var exactSerialRow = null;

                    rows.forEach(function (row) {

                        var serialElement =
                            row.querySelector(
                                ".serial-number"
                            );

                        if (!serialElement) {
                            return;
                        }

                        var serial =
                            serialElement.textContent
                                .trim();

                        if (
                            serial === searchText
                        ) {

                            exactSerialRow = row;

                        }

                    });


                    /* =================================================
                       EXACT SERIAL FOUND
                       
                       Hide everything else and open that service.
                       ================================================= */

                    if (exactSerialRow) {

                        rows.forEach(function (row) {

                            row.classList.remove(
                                "search-match"
                            );

                            if (row === exactSerialRow) {

                                row.style.display = "";

                            }
                            else {

                                row.style.display = "none";

                            }

                        });


                        exactSerialRow.classList.add(
                            "search-match"
                        );


                        openServiceDetails(
                            exactSerialRow
                        );


                        return;
                    }


                    /* =================================================
                       NORMAL TEXT SEARCH
                       
                       If the search is not an exact serial number,
                       search the complete row.
                       
                       Example:
                       "जन्म"
                       "नागरिकता"
                       "पासपोर्ट"
                       "राजस्व"
                       ================================================= */

                    rows.forEach(function (row) {

                        row.classList.remove(
                            "search-match"
                        );


                        var rowText =
                            row.textContent
                                .toLowerCase()
                                .trim();


                        if (
                            rowText.indexOf(searchText) !== -1
                        ) {

                            row.style.display = "";

                            matchingRows.push(row);

                        }
                        else {

                            row.style.display = "none";

                        }

                    });


                    /* =================================================
                       ONE TEXT RESULT
                       ================================================= */

                    if (matchingRows.length === 1) {

                        var onlyRow =
                            matchingRows[0];

                        onlyRow.classList.add(
                            "search-match"
                        );

                        openServiceDetails(
                            onlyRow
                        );

                    }

                }
            );


            /* =================================================
               CLICK MATCHING SERVICE ROW
               ================================================= */

            tableBody.addEventListener(
                "click",
                function (event) {

                    var row =
                        event.target.closest(
                            ".service-row"
                        );

                    if (!row) {
                        return;
                    }


                    /*
                     * When searching, clicking the matching
                     * service opens the complete popup.
                     */

                    if (
                        searchInput &&
                        searchInput.value.trim() !== ""
                    ) {

                        openServiceDetails(row);

                    }

                }
            );

        }


        /* =====================================================
           CLOSE SERVICE POPUP BY CLICKING OUTSIDE
           ===================================================== */

        if (serviceDetailModal) {

            serviceDetailModal.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target ===
                        serviceDetailModal
                    ) {

                        closeServiceDetails();

                    }

                }
            );

        }


        /* =====================================================
           SERVICE POPUP ESCAPE KEY
           ===================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    closeServiceDetails();

                }

            }
        );


        /* =====================================================
           SERVICE TABLE AUTO SCROLL
           
           Slightly faster than the previous version.
           Still slow enough for comfortable reading.
           Automatically pauses while user interacts.
           ===================================================== */

        if (tableScroll) {

            var autoScrolling = true;

            var scrollSpeed = 1.35;

            var resumeDelay = 3000;

            var resumeTimer = null;


            function autoScroll() {

                if (!autoScrolling) {
                    return;
                }

                if (
                    tableScroll.scrollHeight <=
                    tableScroll.clientHeight
                ) {
                    return;
                }


                if (
                    tableScroll.scrollTop +
                    tableScroll.clientHeight >=
                    tableScroll.scrollHeight - 1
                ) {

                    tableScroll.scrollTop = 0;

                }
                else {

                    tableScroll.scrollTop +=
                        scrollSpeed;

                }

            }


            /*
             * Approximately 25% faster than the
             * previous 1px / 40ms configuration.
             */

            setInterval(
                autoScroll,
                40
            );


            function pauseAutoScroll() {

                autoScrolling = false;

                if (resumeTimer) {

                    clearTimeout(
                        resumeTimer
                    );

                }

            }


            function resumeAutoScrollLater() {

                if (resumeTimer) {

                    clearTimeout(
                        resumeTimer
                    );

                }

                resumeTimer =
                    setTimeout(
                        function () {

                            if (
                                !tableScroll.matches(
                                    ":hover"
                                )
                            ) {

                                autoScrolling = true;

                            }

                        },
                        resumeDelay
                    );

            }


            tableScroll.addEventListener(
                "mouseenter",
                function () {

                    pauseAutoScroll();

                }
            );


            tableScroll.addEventListener(
                "mouseleave",
                function () {

                    resumeAutoScrollLater();

                }
            );


            tableScroll.addEventListener(
                "wheel",
                function () {

                    pauseAutoScroll();

                    resumeAutoScrollLater();

                }
            );


            tableScroll.addEventListener(
                "touchstart",
                function () {

                    pauseAutoScroll();

                }
            );


            tableScroll.addEventListener(
                "touchend",
                function () {

                    resumeAutoScrollLater();

                }
            );

        }


        /* =====================================================
           PEOPLE DATA
           
           Representatives and employees are combined into
           one array so the right-side display rotates through
           everyone.
           ===================================================== */

        var people = [];


        /* =====================================================
           REPRESENTATIVES
           ===================================================== */

        @if (Model != null &&
             Model.peopleRepresentative != null &&
             Model.peopleRepresentative.List != null)
        {
            foreach (var person in Model.peopleRepresentative.List)
            {
                var image = !string.IsNullOrWhiteSpace(person.ImageUrl)
                        ? person.ImageUrl
                        : null;
                var post =
                    person.PostSetup != null
                        ? person.PostSetup.PostTitle
                        : "";

                <text>
                    people.push({
                        name: @Html.Raw(Json.Encode(person.Name ?? "")),
                        post: @Html.Raw(Json.Encode(post ?? "")),
                        contact: @Html.Raw(Json.Encode(person.Contact ?? "")),
                        image: @Html.Raw(Json.Encode(image)),
                        type: "जनप्रतिनिधि"
                    });
                </text>
            }
        }


        /* =====================================================
           EMPLOYEES
           ===================================================== */

        @if (Model != null &&
             Model.employeeSetup != null &&
             Model.employeeSetup.Lists != null)
        {
            foreach (var employee in Model.employeeSetup.Lists)
            {
                var image =
                    !string.IsNullOrWhiteSpace(employee.ImageUrl)
                        ? employee.ImageUrl
                        :null;

                var post =
                    employee.PostSetup != null
                        ? employee.PostSetup.PostTitle
                        : "";

                <text>
                    people.push({
                        name: @Html.Raw(Json.Encode(employee.EmpName ?? "")),
                        post: @Html.Raw(Json.Encode(post ?? "")),
                        contact: @Html.Raw(Json.Encode(employee.Contact ?? "")),
                        image: @Html.Raw(Json.Encode(image)),
                        type: "कर्मचारी"
                    });
                </text>
            }
        }


        /* =====================================================
           PEOPLE ROTATION
           ===================================================== */

        var personDisplay =
            document.getElementById("personDisplay");

        var currentPersonIndex = 0;


        function showPerson(index) {

            if (
                !personDisplay ||
                people.length === 0
            ) {

                if (personDisplay) {

                    personDisplay.innerHTML =
                        '<div class="no-service">' +
                        '<div>' +
                        '<i class="fa fa-user fa-2x"></i>' +
                        '<br><br>' +
                        'हाल कुनै प्रतिनिधि / कर्मचारी उपलब्ध छैन।' +
                        '</div>' +
                        '</div>';

                }

                return;

            }


            var person =
                people[index];


            var html =

                '<div class="person-card">' +

                    '<div class="person-image-wrapper">' +

                        '<img ' +
                            'src="' +
                            escapeHtmlAttribute(person.image) +
                            '" ' +
                            'class="person-image" ' +
                            'alt="' +
                            escapeHtmlAttribute(person.name) +
                            '">' +

                    '</div>' +

                    '<div class="person-name">' +
                        escapeHtml(person.name) +
                    '</div>' +

                    '<div class="person-post">' +
                        escapeHtml(person.post) +
                    '</div>';


            if (person.contact) {

                html +=

                    '<div class="person-contact">' +

                        '<i class="fa fa-phone"></i>' +

                        escapeHtml(person.contact) +

                    '</div>';

            }


            html +=

                    '<div class="person-type">' +
                        escapeHtml(person.type) +
                    '</div>' +

                    '<div class="person-dots">';


            /*
             * Display indicators for the current person.
             */

            people.forEach(function (item, dotIndex) {

                html +=

                    '<span class="person-dot ' +
                    (
                        dotIndex === index
                            ? "active"
                            : ""
                    ) +
                    '"></span>';

            });


            html +=

                    '</div>' +

                '</div>';


            personDisplay.innerHTML =
                html;

        }


        /* =====================================================
           SMALL HTML ESCAPING HELPERS
           Prevents person data from breaking generated HTML.
           ===================================================== */

        function escapeHtml(value) {

            if (value === null ||
                value === undefined) {

                return "";

            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        function escapeHtmlAttribute(value) {

            return escapeHtml(value);

        }


        /* =====================================================
           DISPLAY FIRST PERSON IMMEDIATELY
           ===================================================== */

        if (people.length > 0) {

            showPerson(0);


            /*
             * Rotate every six seconds.
             */

            if (people.length > 1) {

                setInterval(
                    function () {

                        currentPersonIndex++;

                        if (
                            currentPersonIndex >=
                            people.length
                        ) {

                            currentPersonIndex = 0;

                        }

                        showPerson(
                            currentPersonIndex
                        );

                    },
                    6000
                );

            }

        }
        else {

            showPerson(0);

        }


        /* =====================================================
           PEOPLE LIST MODAL
           ===================================================== */

        var peopleListModal =
            document.getElementById(
                "peopleListModal"
            );

        var openPeopleList =
            document.getElementById(
                "openPeopleList"
            );

        var closePeopleList =
            document.getElementById(
                "closePeopleList"
            );


        /* =====================================================
           OPEN PEOPLE LIST
           ===================================================== */

        if (openPeopleList) {

            openPeopleList.addEventListener(
                "click",
                function () {

                    if (!peopleListModal) {
                        return;
                    }

                    peopleListModal.style.display =
                        "flex";

                    document.body.style.overflow =
                        "hidden";

                }
            );

        }


        /* =====================================================
           CLOSE PEOPLE LIST
           ===================================================== */

        function closePeopleModal() {

            if (!peopleListModal) {
                return;
            }

            peopleListModal.style.display =
                "none";

            document.body.style.overflow =
                "";

        }


        if (closePeopleList) {

            closePeopleList.addEventListener(
                "click",
                closePeopleModal
            );

        }


        /* =====================================================
           CLOSE PEOPLE MODAL OUTSIDE DIALOG
           ===================================================== */

        if (peopleListModal) {

            peopleListModal.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target ===
                        peopleListModal
                    ) {

                        closePeopleModal();

                    }

                }
            );

        }

    });

</script>
@model HelpDesk.Models.HomePageViewModel

@{
    ViewBag.Title = "सेवा तथा जानकारी";
    Layout = "~/Views/Shared/_WebSiteLayout.cshtml";
}

<style>

    /* =========================================================
       GLOBAL PAGE
       ========================================================= */

    .service-home {
        width: 100%;
        height: calc(100vh - 150px);
        min-height: 550px;
        padding: 12px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        font-family: "Kalimati", "Noto Sans Devanagari", "Mangal", Arial, sans-serif;
        overflow: hidden;
    }


    /* =========================================================
       MAIN LAYOUT
       LEFT  = HEADER + SERVICE TABLE
       RIGHT = VIDEO + PEOPLE
       ========================================================= */

    .service-page-layout {
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 12px;
        overflow: hidden;
    }


    /* =========================================================
       LEFT SECTION
       HEADER AND TABLE ARE ONE SINGLE CARD
       ========================================================= */

    .service-left-section {
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        box-shadow: 0 3px 14px rgba(15, 31, 61, .10);
        overflow: hidden;
    }


    /* =========================================================
       SERVICE HEADER
       SAME WIDTH AS THE TABLE
       ========================================================= */

    .service-header {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 11px 16px;
        background: linear-gradient(90deg, #172554, #1e3a5f);
        color: #ffffff;
        border-bottom: 4px solid #d4af37;
        box-sizing: border-box;
    }

    .service-header-left {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .service-title {
        margin: 0;
        font-size: clamp(20px, 1.5vw, 28px);
        font-weight: 700;
        line-height: 1.35;
        white-space: nowrap;
    }

    .service-subtitle {
        margin-top: 2px;
        font-size: clamp(12px, .8vw, 16px);
        color: #dbe4f0;
        line-height: 1.4;
    }

    .service-header-right {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
    }


    /* =========================================================
       DATE AND TIME
       ========================================================= */

    .service-date-time {
        text-align: right;
        white-space: nowrap;
    }

    .service-date {
        font-size: clamp(11px, .75vw, 15px);
        color: #dbe4f0;
    }

    .service-time {
        margin-top: 2px;
        font-size: clamp(13px, .9vw, 18px);
        font-weight: 700;
        color: #ffffff;
    }


    /* =========================================================
       SERVICE SEARCH
       ========================================================= */

    .service-search {
        position: relative;
        width: clamp(190px, 18vw, 290px);
    }

    .service-search input {
        width: 100%;
        height: 40px;
        padding: 7px 40px 7px 13px;
        box-sizing: border-box;
        border: 2px solid transparent;
        border-radius: 6px;
        outline: none;
        font-family: inherit;
        font-size: clamp(13px, .8vw, 16px);
        background: #ffffff;
        color: #172554;
        box-shadow: 0 2px 6px rgba(0, 0, 0, .12);
        transition: .2s ease;
    }

    .service-search input:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 2px rgba(212, 175, 55, .18);
    }

    .service-search input::placeholder {
        color: #7a8798;
    }

    .service-search-icon {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        pointer-events: none;
    }


    /* =========================================================
       SERVICE TABLE AREA
       ========================================================= */

    .service-table-container {
        flex: 1 1 auto;
        min-height: 0;
        position: relative;
        overflow: hidden;
        background: #ffffff;
    }

    .service-table-scroll {
        width: 100%;
        height: 100%;
        overflow-x: auto;
        overflow-y: auto;
        scroll-behavior: auto;
    }


    /* =========================================================
       SERVICE TABLE
       ========================================================= */

    .service-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

    .service-table thead th {
        position: sticky;
        top: 0;
        z-index: 10;
        padding: 11px 8px;
        background: #172554;
        color: #ffffff;
        border-right: 1px solid #34436d;
        border-bottom: 3px solid #d4af37;
        font-size: clamp(12px, .8vw, 16px);
        font-weight: 700;
        text-align: center;
        vertical-align: middle;
        line-height: 1.45;
    }

    .service-table thead th:last-child {
        border-right: none;
    }

    .service-table tbody td {
        padding: 11px 10px;
        color: #172033;
        border-right: 1px solid rgba(15, 23, 42, .12);
        border-bottom: 1px solid rgba(15, 23, 42, .12);
        font-size: clamp(12px, .78vw, 16px);
        line-height: 1.55;
        vertical-align: top;
        word-break: break-word;
    }

    .service-table tbody td:last-child {
        border-right: none;
    }

    .service-table tbody tr {
        transition: filter .15s ease, transform .15s ease;
    }

    .service-table tbody tr:hover td {
        filter: brightness(.94);
    }


    /* =========================================================
       BRIGHT ALTERNATING SERVICE ROW COLORS
       HIGH CONTRAST FOR READABILITY
       ========================================================= */

    .service-table tbody tr:nth-child(6n + 1) td {
        background: #fff3b8;
    }

    .service-table tbody tr:nth-child(6n + 2) td {
        background: #cceeff;
    }

    .service-table tbody tr:nth-child(6n + 3) td {
        background: #d9f7c8;
    }

    .service-table tbody tr:nth-child(6n + 4) td {
        background: #ffd6d6;
    }

    .service-table tbody tr:nth-child(6n + 5) td {
        background: #e6d7ff;
    }

    .service-table tbody tr:nth-child(6n + 6) td {
        background: #ffe0b2;
    }


    /* =========================================================
       TABLE COLUMN WIDTHS
       ========================================================= */

    .serial-column {
        width: 55px;
        text-align: center !important;
    }

    .service-name-column {
        width: 19%;
    }

    .process-column {
        width: 31%;
    }

    .fee-column {
        width: 14%;
    }

    .time-column {
        width: 11%;
    }

    .officer-column {
        width: 17%;
    }


    /* =========================================================
       TABLE CONTENT
       ========================================================= */

    .serial-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 27px;
        height: 27px;
        padding: 0 5px;
        box-sizing: border-box;
        border-radius: 50%;
        background: #172554;
        color: #ffffff;
        font-weight: 700;
    }

    .service-name {
        color: #172554;
        font-size: clamp(14px, .9vw, 18px);
        font-weight: 800;
        line-height: 1.45;
    }

    .service-detail {
        margin-bottom: 7px;
    }

    .service-detail:last-child {
        margin-bottom: 0;
    }

    .detail-label {
        display: block;
        margin-bottom: 2px;
        color: #172554;
        font-weight: 800;
    }

    .fee-value,
    .time-value,
    .officer-value {
        color: #172033;
        font-weight: 700;
    }


    /* =========================================================
       EMPTY SERVICE MESSAGE
       ========================================================= */

    .no-service {
        width: 100%;
        height: 100%;
        min-height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        font-size: 18px;
        text-align: center;
    }


    /* =========================================================
       RIGHT SIDE
       VIDEO + EMPLOYEE SECTION
       ========================================================= */

    .service-right-section {
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
        overflow: hidden;
    }


    /* =========================================================
       VIDEO SECTION
       ONLY VIDEO IS DISPLAYED
       VIDEO KEEPS ITS NATURAL 16:9 PROPORTION
       ========================================================= */

    .video-panel {
        flex: 0 0 auto;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #000000;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(15, 31, 61, .12);
        position: relative;
    }

    .video-panel .video-detail {
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        background: #000000 !important;
        overflow: hidden !important;
    }

    .video-panel .video-player-wrapper {
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        background: #000000 !important;
        overflow: hidden !important;
    }

    .video-panel .player {
        display: block;
        width: 100% !important;
        height: 100% !important;
        max-width: 100% !important;
        max-height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #000000 !important;
        border: none !important;
        border-radius: 0 !important;
        object-fit: contain !important;
        outline: none !important;
    }

    /* Hide all information below the video. */
    .video-panel .video-information {
        display: none !important;
    }

    /* Hide controls even if the partial contains them. */
    .video-panel video {
        pointer-events: none;
    }

    .video-panel .video-not-available {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #cbd5e1;
        background: #000000;
        text-align: center;
    }


    /* =========================================================
       PEOPLE / EMPLOYEE PANEL
       ========================================================= */

    .people-panel {
        flex: 1 1 auto;
        min-height: 0;
        width: 100%;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 3px 12px rgba(15, 31, 61, .10);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .people-header {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 9px 11px;
        background: #172554;
        color: #ffffff;
        border-bottom: 3px solid #d4af37;
    }

    .people-header-title {
        margin: 0;
        font-size: clamp(14px, .9vw, 18px);
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .people-list-button {
        flex: 0 0 auto;
        width: 31px;
        height: 31px;
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 5px;
        background: rgba(255,255,255,.1);
        color: #ffffff;
        cursor: pointer;
        transition: .2s ease;
    }

    .people-list-button:hover {
        background: #d4af37;
        color: #172554;
    }


    /* =========================================================
       CURRENT PERSON DISPLAY
       ========================================================= */

    .person-display {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        overflow: hidden;
    }

    .person-card {
        width: 100%;
        text-align: center;
    }

    .person-image-wrapper {
        width: min(115px, 42%);
        aspect-ratio: 5 / 6;
        margin: 0 auto 9px;
        border-radius: 8px;
        overflow: hidden;
        border: 3px solid #d4af37;
        background: #f1f5f9;
        box-shadow: 0 3px 10px rgba(0,0,0,.12);
    }

    .person-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .person-name {
        margin: 0;
        color: #172554;
        font-size: clamp(15px, 1vw, 19px);
        font-weight: 800;
        line-height: 1.4;
        word-break: break-word;
    }

    .person-post {
        margin-top: 4px;
        color: #475569;
        font-size: clamp(12px, .75vw, 15px);
        font-weight: 600;
        line-height: 1.4;
    }

    .person-contact {
        margin-top: 6px;
        color: #334155;
        font-size: clamp(11px, .7vw, 14px);
    }

    .person-contact i {
        color: #172554;
        margin-right: 4px;
    }

    .person-type {
        display: inline-block;
        margin-top: 7px;
        padding: 3px 9px;
        border-radius: 20px;
        background: #eef4ff;
        color: #172554;
        font-size: 11px;
        font-weight: 700;
    }

    .person-dots {
        margin-top: 9px;
        display: flex;
        justify-content: center;
        gap: 4px;
        max-width: 100%;
        overflow: hidden;
    }

    .person-dot {
        flex: 0 0 auto;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #cbd5e1;
        transition: .2s ease;
    }

    .person-dot.active {
        background: #172554;
        transform: scale(1.25);
    }


    /* =========================================================
       PEOPLE LIST MODAL
       ========================================================= */

    .people-list-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, .72);
        padding: 25px;
        box-sizing: border-box;
    }

    .people-list-dialog {
        width: 100%;
        max-width: 1000px;
        height: 88vh;
        margin: auto;
        background: #ffffff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,.3);
        display: flex;
        flex-direction: column;
    }

    .people-list-header {
        flex: 0 0 auto;
        padding: 13px 17px;
        background: #172554;
        color: #ffffff;
        border-bottom: 4px solid #d4af37;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .people-list-header h3 {
        margin: 0;
        font-size: 20px;
    }

    .people-list-close {
        width: 35px;
        height: 35px;
        border: none;
        border-radius: 5px;
        background: rgba(255,255,255,.1);
        color: #ffffff;
        font-size: 20px;
        cursor: pointer;
    }

    .people-list-close:hover {
        background: #ef5350;
    }

    .people-list-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 15px;
    }

    .people-list-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .people-list-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
        border: 1px solid #dce2e9;
        border-radius: 7px;
        background: #f8fafc;
        min-width: 0;
    }

    .people-list-item:hover {
        background: #eef4ff;
    }

    .people-list-image {
        width: 65px;
        height: 75px;
        flex: 0 0 65px;
        object-fit: cover;
        border-radius: 6px;
        border: 2px solid #d4af37;
    }

    .people-list-name {
        font-weight: 700;
        color: #172554;
        font-size: 15px;
        word-break: break-word;
    }

    .people-list-post {
        margin-top: 3px;
        color: #64748b;
        font-size: 12px;
    }

    .people-list-contact {
        margin-top: 3px;
        color: #475569;
        font-size: 12px;
    }


    /* =========================================================
       SERVICE SEARCH POPUP
       SHOWS THE COMPLETE SERVICE
       ========================================================= */

    .service-detail-modal {
        display: none;
        position: fixed;
        z-index: 10000;
        inset: 0;
        padding: 20px;
        box-sizing: border-box;
        background: rgba(15, 23, 42, .72);
        overflow-y: auto;
    }

    .service-detail-dialog {
        width: min(100%, 1050px);
        max-height: calc(100vh - 40px);
        margin: 0 auto;
        background: #ffffff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(0,0,0,.35);
        display: flex;
        flex-direction: column;
    }

    .service-detail-header {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 17px;
        background: #172554;
        color: #ffffff;
        border-bottom: 4px solid #d4af37;
    }

    .service-detail-header-title {
        min-width: 0;
        font-size: clamp(17px, 1.2vw, 23px);
        font-weight: 700;
        line-height: 1.4;
    }

    .service-detail-close {
        flex: 0 0 auto;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 5px;
        background: rgba(255,255,255,.12);
        color: #ffffff;
        font-size: 20px;
        cursor: pointer;
    }

    .service-detail-close:hover {
        background: #ef5350;
    }

    .service-detail-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 18px;
    }

    .service-detail-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        overflow: hidden;
    }

    .service-detail-table th {
        width: 24%;
        padding: 13px;
        background: #eef4ff;
        color: #172554;
        border-right: 1px solid #cbd5e1;
        border-bottom: 1px solid #cbd5e1;
        text-align: left;
        vertical-align: top;
        font-weight: 800;
        line-height: 1.5;
    }

    .service-detail-table td {
        padding: 13px;
        background: #ffffff;
        color: #172033;
        border-bottom: 1px solid #cbd5e1;
        vertical-align: top;
        line-height: 1.65;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .service-detail-table tr:last-child th,
    .service-detail-table tr:last-child td {
        border-bottom: none;
    }


    /* =========================================================
       SEARCH HIGHLIGHT
       ========================================================= */

    .service-row.search-match {
        outline: 3px solid #172554;
        outline-offset: -3px;
    }


    /* =========================================================
       SCROLLBARS
       ========================================================= */

    .service-table-scroll::-webkit-scrollbar,
    .people-list-body::-webkit-scrollbar,
    .service-detail-body::-webkit-scrollbar {
        width: 9px;
        height: 9px;
    }

    .service-table-scroll::-webkit-scrollbar-track,
    .people-list-body::-webkit-scrollbar-track,
    .service-detail-body::-webkit-scrollbar-track {
        background: #eef2f7;
    }

    .service-table-scroll::-webkit-scrollbar-thumb,
    .people-list-body::-webkit-scrollbar-thumb,
    .service-detail-body::-webkit-scrollbar-thumb {
        background: #9aa8bb;
        border-radius: 10px;
    }

    .service-table-scroll::-webkit-scrollbar-thumb:hover,
    .people-list-body::-webkit-scrollbar-thumb:hover,
    .service-detail-body::-webkit-scrollbar-thumb:hover {
        background: #172554;
    }


    /* =========================================================
       RESPONSIVE - LARGE TV / DISPLAY BOARD
       ========================================================= */

    @@media screen and (min-width: 1600px) {

        .service-home {
            padding: 16px;
        }

        .service-page-layout {
            grid-template-columns: minmax(0, 1fr) 380px;
            gap: 16px;
        }

        .service-header {
            padding: 14px 20px;
        }

        .service-table thead th {
            padding: 14px 10px;
        }

        .service-table tbody td {
            padding: 14px 12px;
        }

        .people-header {
            padding: 12px 14px;
        }

        .person-image-wrapper {
            width: 145px;
        }
    }


    /* =========================================================
       RESPONSIVE - VERY LARGE TV
       ========================================================= */

    @@media screen and (min-width: 2500px) {

        .service-page-layout {
            grid-template-columns: minmax(0, 1fr) 460px;
            gap: 18px;
        }

        .service-header {
            padding: 17px 24px;
        }

        .service-table thead th {
            font-size: 20px;
            padding: 17px 12px;
        }

        .service-table tbody td {
            font-size: 19px;
            padding: 17px 14px;
            line-height: 1.65;
        }

        .service-name {
            font-size: 21px;
        }

        .person-image-wrapper {
            width: 175px;
        }

        .person-name {
            font-size: 22px;
        }

        .person-post {
            font-size: 17px;
        }
    }


    /* =========================================================
   RESPONSIVE - TABLET AND SMALLER
   PAGE ITSELF NEVER SCROLLS.
   ONLY TABLE CONTENT SCROLLS INTERNALLY.
   ========================================================= */

    @@media screen and (max-width: 1100px) {

        .service-home {
            width: 100%;
            height: 100%;
            min-height: 0;
            padding: 8px;
            overflow: hidden;
            box-sizing: border-box;
        }

        /*
     * Keep the whole page inside the available viewport.
     * The table and right section are allowed to shrink.
     */
        .service-page-layout {
            width: 100%;
            height: 100%;
            min-height: 0;
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: minmax(0, 1fr) minmax(0, 42%);
            gap: 8px;
            overflow: hidden;
        }

        /*
     * LEFT SERVICE CARD
     */
        .service-left-section {
            width: 100%;
            min-width: 0;
            min-height: 0;
            height: 100%;
            overflow: hidden;
        }

        /*
     * HEADER can become smaller on narrow screens.
     */
        .service-header {
            flex: 0 0 auto;
            padding: 9px 11px;
            gap: 8px;
        }

        /*
     * IMPORTANT:
     * This is the ONLY main content area that scrolls.
     */
        .service-table-container {
            min-width: 0;
            min-height: 0;
            height: 100%;
            overflow: hidden;
        }

        .service-table-scroll {
            width: 100%;
            height: 100%;
            min-width: 0;
            overflow-x: auto;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        /*
     * Keep the table wide enough to remain readable.
     * On a small screen the user can swipe/scroll horizontally.
     */
        .service-table {
            min-width: 900px;
        }

        /*
     * RIGHT SECTION GOES BELOW THE TABLE.
     */
        .service-right-section {
            width: 100%;
            min-width: 0;
            min-height: 0;
            height: 100%;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 8px;
            overflow: hidden;
        }


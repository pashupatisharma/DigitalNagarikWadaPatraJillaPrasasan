@model HelpDesk.Models.HomePageViewModel

@{
    ViewBag.Title = "सेवा तथा जानकारी";
    Layout = "~/Views/Shared/_WebSiteLayout.cshtml";

    // ---------------------------------------------------------
    // PEOPLE (representatives + employees) -> one JSON list
    // ---------------------------------------------------------
    var noImage = Url.Content("~/Content/images/no-image.png");
    var peopleData = new List<object>();

    if (Model != null && Model.peopleRepresentative != null && Model.peopleRepresentative.List != null)
    {
        foreach (var p in Model.peopleRepresentative.List)
        {
            peopleData.Add(new
            {
                name = p.Name ?? "",
                post = p.PostSetup != null ? p.PostSetup.PostTitle : "",
                contact = p.Contact ?? "",
                image = !string.IsNullOrWhiteSpace(p.Image)
                    ? Url.Content("~/JanaPratinidhiImages/" + p.Image)
                    : noImage,
                type = "जनप्रतिनिधि"
            });
        }
    }

    if (Model != null && Model.employeeSetup != null && Model.employeeSetup.Lists != null)
    {
        foreach (var e in Model.employeeSetup.Lists)
        {
            peopleData.Add(new
            {
                name = e.EmpName ?? "",
                post = e.PostSetup != null ? e.PostSetup.PostTitle : "",
                contact = e.Contact ?? "",
                image = !string.IsNullOrWhiteSpace(e.Image)
                    ? Url.Content("~/EmployeeImage/" + e.Image)
                    : noImage,
                type = "कर्मचारी"
            });
        }
    }
}

<style>

    /* =========================================================
       EVERYTHING IS IN rem  ->  scales with the TV size
       (1rem = 16px on 1080p, 32px on 4K; set in the layout)
       ========================================================= */

    .service-home {
        flex: 1 1 auto;
        min-height: 0;
        display: -webkit-flex;
        display: flex;
        -webkit-flex-direction: column;
        flex-direction: column;
        padding: .7rem;
        box-sizing: border-box;
        overflow: hidden;
    }

    .service-page-layout {
        flex: 1 1 auto;
        min-height: 0;
        display: -webkit-flex;
        display: flex;
        overflow: hidden;
    }

    /* ---------- LEFT : header + table in one card ---------- */
    .service-left-section {
        flex: 1 1 auto;
        min-width: 0;
        min-height: 0;
        display: -webkit-flex;
        display: flex;
        -webkit-flex-direction: column;
        flex-direction: column;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: .5rem;
        box-shadow: 0 .2rem .8rem rgba(15,31,61,.10);
        overflow: hidden;
    }

    .service-header {
        flex: 0 0 auto;
        display: -webkit-flex;
        display: flex;
        -webkit-align-items: center;
        align-items: center;
        -webkit-justify-content: space-between;
        justify-content: space-between;
        padding: .6rem 1.1rem;
        background: linear-gradient(90deg, #172554, #1e3a5f);
        color: #fff;
        border-bottom: .25rem solid #d4af37;
    }

    .service-title {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .service-subtitle {
        font-size: 1rem;
        color: #dbe4f0;
        line-height: 1.4;
    }

    .service-search {
        position: relative;
        flex: 0 0 18rem;
        width: 18rem;
        margin-left: 1rem;
    }

        .service-search input {
            width: 100%;
            height: 2.6rem;
            padding: .3rem 2.6rem .3rem .8rem;
            box-sizing: border-box;
            border: 2px solid transparent;
            border-radius: .35rem;
            outline: none;
            font-family: inherit;
            font-size: 1.05rem;
            background: #fff;
            color: #172554;
        }

            .service-search input:focus {
                border-color: #d4af37;
            }

    .service-search-icon {
        position: absolute;
        right: .8rem;
        top: 50%;
        margin-top: -.55rem;
        color: #64748b;
        pointer-events: none;
    }

    /* ---------- TABLE AREA ---------- */
    .service-table-container {
        flex: 1 1 auto;
        min-height: 0;
        position: relative;
        overflow: hidden;
        background: #fff;
    }

    .service-table-scroll {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        overflow-x: hidden;
        overflow-y: auto;
    }

        .service-table-scroll::-webkit-scrollbar {
            width: .6rem;
        }

        .service-table-scroll::-webkit-scrollbar-thumb {
            background: #9aa8bb;
            border-radius: .5rem;
        }

    .kiosk .service-table-scroll::-webkit-scrollbar {
        display: none;
    }

    .service-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

        .service-table thead th {
            position: -webkit-sticky;
            position: sticky;
            top: 0;
            z-index: 2;
            padding: .6rem .5rem;
            background: #172554;
            color: #fff;
            border-right: 1px solid #34436d;
            border-bottom: .2rem solid #d4af37;
            font-size: 1.1rem;
            font-weight: 700;
            text-align: center;
            vertical-align: middle;
            line-height: 1.4;
        }

            .service-table thead th:last-child {
                border-right: none;
            }

        .service-table tbody td {
            padding: .65rem .7rem;
            color: #172033;
            border-right: 1px solid rgba(15,23,42,.12);
            border-bottom: 1px solid rgba(15,23,42,.12);
            font-size: 1.15rem;
            line-height: 1.5;
            vertical-align: top;
            word-break: break-word;
        }

            .service-table tbody td:last-child {
                border-right: none;
            }

        /* alternating high-contrast row colours */
        .service-table tbody tr:nth-child(6n + 1) td { background: #fff3b8; }
        .service-table tbody tr:nth-child(6n + 2) td { background: #cceeff; }
        .service-table tbody tr:nth-child(6n + 3) td { background: #d9f7c8; }
        .service-table tbody tr:nth-child(6n + 4) td { background: #ffd6d6; }
        .service-table tbody tr:nth-child(6n + 5) td { background: #e6d7ff; }
        .service-table tbody tr:nth-child(6n + 6) td { background: #ffe0b2; }

    .serial-column { width: 4rem; text-align: center !important; }
    .service-name-column { width: 19%; }
    .process-column { width: 31%; }
    .fee-column { width: 14%; }
    .time-column { width: 11%; }
    .officer-column { width: 17%; }

    .serial-number {
        display: inline-block;
        min-width: 2rem;
        height: 2rem;
        line-height: 2rem;
        padding: 0 .2rem;
        box-sizing: border-box;
        border-radius: 1rem;
        background: #172554;
        color: #fff;
        font-weight: 700;
        text-align: center;
    }

    .service-name {
        color: #172554;
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .service-detail { margin-bottom: .45rem; }
    .service-detail:last-child { margin-bottom: 0; }

    .detail-label {
        display: block;
        margin-bottom: .1rem;
        color: #172554;
        font-weight: 700;
    }

    .fee-value, .time-value, .officer-value {
        color: #172033;
        font-weight: 700;
    }

    .service-row.search-match {
        outline: .2rem solid #172554;
        outline-offset: -.2rem;
    }

    .no-service {
        width: 100%;
        height: 100%;
        min-height: 12rem;
        display: -webkit-flex;
        display: flex;
        -webkit-align-items: center;
        align-items: center;
        -webkit-justify-content: center;
        justify-content: center;
        color: #64748b;
        font-size: 1.2rem;
        text-align: center;
    }

    /* ---------- RIGHT : video + people ---------- */
    .service-right-section {
        flex: 0 0 28rem;
        width: 28rem;
        margin-left: .8rem;
        min-height: 0;
        display: -webkit-flex;
        display: flex;
        -webkit-flex-direction: column;
        flex-direction: column;
        overflow: hidden;
    }

    /* 16:9 box WITHOUT aspect-ratio (older TV browsers don't have it) */
    .video-panel {
        flex: 0 0 auto;
        position: relative;
        width: 100%;
        height: 0;
        padding-top: 56.25%;
        background: #000;
        border: 1px solid #cbd5e1;
        border-radius: .5rem;
        overflow: hidden;
        box-sizing: border-box;
    }

        .video-panel > * {
            position: absolute;
            top: 0;
            left: 0;
            width: 100% !important;
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #000 !important;
            overflow: hidden !important;
        }

        .video-panel .video-detail,
        .video-panel .video-player-wrapper {
            width: 100% !important;
            height: 100% !important;
            min-height: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
            background: #000 !important;
            overflow: hidden !important;
        }

        .video-panel .player,
        .video-panel video {
            display: block;
            width: 100% !important;
            height: 100% !important;
            max-width: 100% !important;
            max-height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #000 !important;
            border: none !important;
            border-radius: 0 !important;
            -o-object-fit: contain;
            object-fit: contain;
            outline: none !important;
            pointer-events: none;
        }

        .video-panel .video-information {
            display: none !important;
        }

    .video-not-available {
        display: -webkit-flex;
        display: flex;
        -webkit-align-items: center;
        align-items: center;
        -webkit-justify-content: center;
        justify-content: center;
        color: #cbd5e1;
        text-align: center;
    }

    .people-panel {
        flex: 1 1 auto;
        min-height: 0;
        margin-top: .8rem;
        display: -webkit-flex;
        display: flex;
        -webkit-flex-direction: column;
        flex-direction: column;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: .5rem;
        box-shadow: 0 .2rem .8rem rgba(15,31,61,.10);
        overflow: hidden;
    }

    .people-header {
        flex: 0 0 auto;
        display: -webkit-flex;
        display: flex;
        -webkit-align-items: center;
        align-items: center;
        -webkit-justify-content: space-between;
        justify-content: space-between;
        padding: .5rem .8rem;
        background: #172554;
        color: #fff;
        border-bottom: .2rem solid #d4af37;
    }

    .people-header-title {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .people-list-button {
        flex: 0 0 auto;
        width: 2.2rem;
        height: 2.2rem;
        border: 1px solid rgba(255,255,255,.35);
        border-radius: .3rem;
        background: rgba(255,255,255,.1);
        color: #fff;
        cursor: pointer;
    }

    .person-display {
        flex: 1 1 auto;
        min-height: 0;
        display: -webkit-flex;
        display: flex;
        -webkit-align-items: center;
        align-items: center;
        -webkit-justify-content: center;
        justify-content: center;
        padding: .7rem;
        overflow: hidden;
    }

    .person-card {
        width: 100%;
        text-align: center;
    }

    /* fixed size instead of aspect-ratio */
    .person-image-wrapper {
        width: 9rem;
        height: 10.8rem;
        margin: 0 auto .6rem;
        border: .2rem solid #d4af37;
        border-radius: .5rem;
        background: #f1f5f9;
        overflow: hidden;
    }

    .person-image {
        display: block;
        width: 100%;
        height: 100%;
        -o-object-fit: cover;
        object-fit: cover;
    }

    .person-name {
        color: #172554;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.35;
        word-break: break-word;
    }

    .person-post {
        margin-top: .2rem;
        color: #475569;
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.35;
    }

    .person-contact {
        margin-top: .3rem;
        color: #334155;
        font-size: 1.05rem;
    }

        .person-contact i {
            color: #172554;
            margin-right: .3rem;
        }

    .person-type {
        display: inline-block;
        margin-top: .4rem;
        padding: .1rem .7rem;
        border-radius: 1rem;
        background: #eef4ff;
        color: #172554;
        font-size: .9rem;
        font-weight: 700;
    }

    .person-counter {
        margin-top: .4rem;
        color: #64748b;
        font-size: .9rem;
    }

    /* ---------- POPUPS ---------- */
    .people-list-modal,
    .service-detail-modal {
        display: none;
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 9999;
        padding: 1.2rem;
        box-sizing: border-box;
        background: rgba(15,23,42,.72);
        -webkit-align-items: center;
        align-items: center;
        -webkit-justify-content: center;
        justify-content: center;
    }

    .people-list-dialog,
    .service-detail-dialog {
        width: 100%;
        max-width: 70rem;
        display: -webkit-flex;
        display: flex;
        -webkit-flex-direction: column;
        flex-direction: column;
        background: #fff;
        border-radius: .6rem;
        overflow: hidden;
        box-shadow: 0 .8rem 2.5rem rgba(0,0,0,.35);
    }

    .people-list-dialog { height: 88vh; }
    .service-detail-dialog { max-height: 90vh; }

    .people-list-header,
    .service-detail-header {
        flex: 0 0 auto;
        display: -webkit-flex;
        display: flex;
        -webkit-align-items: center;
        align-items: center;
        -webkit-justify-content: space-between;
        justify-content: space-between;
        padding: .7rem 1rem;
        background: #172554;
        color: #fff;
        border-bottom: .25rem solid #d4af37;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .people-list-close,
    .service-detail-close {
        flex: 0 0 auto;
        width: 2.4rem;
        height: 2.4rem;
        border: none;
        border-radius: .3rem;
        background: rgba(255,255,255,.12);
        color: #fff;
        font-size: 1.2rem;
        cursor: pointer;
    }

    .people-list-body,
    .service-detail-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 1rem;
    }

    .people-list-grid {
        display: -webkit-flex;
        display: flex;
        -webkit-flex-wrap: wrap;
        flex-wrap: wrap;
        margin: -.4rem;
    }

    .people-list-item {
        width: 33.333%;
        padding: .4rem;
        box-sizing: border-box;
    }

    .people-list-card {
        display: -webkit-flex;
        display: flex;
        -webkit-align-items: center;
        align-items: center;
        padding: .6rem;
        border: 1px solid #dce2e9;
        border-radius: .45rem;
        background: #f8fafc;
    }

    .people-list-image {
        flex: 0 0 4.2rem;
        width: 4.2rem;
        height: 5rem;
        margin-right: .8rem;
        -o-object-fit: cover;
        object-fit: cover;
        border: 2px solid #d4af37;
        border-radius: .35rem;
    }

    .people-list-text { min-width: 0; }

    .people-list-name {
        color: #172554;
        font-size: 1.05rem;
        font-weight: 700;
        word-break: break-word;
    }

    .people-list-post { margin-top: .15rem; color: #64748b; font-size: .9rem; }
    .people-list-contact { margin-top: .15rem; color: #475569; font-size: .9rem; }

    .service-detail-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #cbd5e1;
    }

        .service-detail-table th {
            width: 24%;
            padding: .8rem;
            background: #eef4ff;
            color: #172554;
            border-right: 1px solid #cbd5e1;
            border-bottom: 1px solid #cbd5e1;
            text-align: left;
            vertical-align: top;
            font-size: 1.1rem;
            font-weight: 700;
            line-height: 1.5;
        }

        .service-detail-table td {
            padding: .8rem;
            background: #fff;
            color: #172033;
            border-bottom: 1px solid #cbd5e1;
            vertical-align: top;
            font-size: 1.1rem;
            line-height: 1.6;
            word-break: break-word;
        }

        .service-detail-table tr:last-child th,
        .service-detail-table tr:last-child td {
            border-bottom: none;
        }

    /* ---------- KIOSK : nothing to click or type on a TV ---------- */
    .kiosk .service-search,
    .kiosk .people-list-button {
        display: none !important;
    }
</style>


<div class="service-home">

    <div class="service-page-layout">

        <!-- =================================================
             LEFT : SERVICE HEADER + TABLE
             ================================================= -->
        <div class="service-left-section">

            <div class="service-header">

                <div>
                    <div class="service-title">
                        <i class="fa fa-building"></i>
                        सेवा तथा जानकारी
                    </div>
                    <div class="service-subtitle">
                        नागरिकलाई उपलब्ध सेवा, प्रक्रिया, दस्तुर तथा जिम्मेवार पदाधिकारी
                    </div>
                </div>

                <div class="service-search">
                    <input type="text"
                           id="serviceSearch"
                           autocomplete="off"
                           placeholder="सेवा खोज्नुहोस्..." />
                    <span class="service-search-icon">
                        <i class="fa fa-search"></i>
                    </span>
                </div>

            </div>

            <div class="service-table-container">

                <div class="service-table-scroll" id="serviceTableScroll">

                    @if (Model != null &&
                         Model.subModule != null &&
                         Model.subModule.List != null &&
                         Model.subModule.List.Any())
                    {
                        <table class="service-table" id="serviceTable">

                            <thead>
                                <tr>
                                    <th class="serial-column">सि.न.</th>
                                    <th class="service-name-column">सेवा सुविधाको नाम</th>
                                    <th class="process-column">सेवा लिने प्रक्रिया/चाहिने कागजातहरू</th>
                                    <th class="fee-column">लाग्ने सेवा शुल्क तथा दस्तुर</th>
                                    <th class="time-column">लाग्ने समय</th>
                                    <th class="officer-column">जिम्मेवार पदाधिकारी</th>
                                </tr>
                            </thead>

                            <tbody id="serviceTableBody">

                                @{
                                    int serialNumber = 1;
                                }

                                @foreach (var service in Model.subModule.List)
                                {
                                    <tr class="service-row">

                                        <td class="serial-column">
                                            <span class="serial-number">@serialNumber</span>
                                        </td>

                                        <td>
                                            <div class="service-name">@service.Title</div>
                                        </td>

                                        <td>
                                            @* Html.Raw: only trusted admins should edit these fields *@
                                            @if (!string.IsNullOrWhiteSpace(service.Process))
                                            {
                                                <div class="service-detail">
                                                    <span class="detail-label">सेवा लिने प्रक्रिया:</span>
                                                    @Html.Raw(service.Process)
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(service.DocumentNeeded))
                                            {
                                                <div class="service-detail">
                                                    <span class="detail-label">चाहिने कागजात:</span>
                                                    @Html.Raw(service.DocumentNeeded)
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            <div class="fee-value">
                                                @if (!string.IsNullOrWhiteSpace(service.DasturNeed))
                                                {
                                                    @service.DasturNeed
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </div>
                                        </td>

                                        <td>
                                            <div class="time-value">
                                                @if (!string.IsNullOrWhiteSpace(service.TimeNeed))
                                                {
                                                    @service.TimeNeed
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </div>
                                        </td>

                                        <td>
                                            <div class="officer-value">
                                                @if (!string.IsNullOrWhiteSpace(service.ResponsibleOfficer))
                                                {
                                                    @service.ResponsibleOfficer
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </div>
                                        </td>

                                    </tr>

                                    serialNumber++;
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <div class="no-service">
                            <div>
                                <i class="fa fa-folder-open fa-2x"></i>
                                <br /><br />
                                हाल कुनै सेवा उपलब्ध छैन।
                            </div>
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- =================================================
             RIGHT : VIDEO + PEOPLE
             ================================================= -->
        <div class="service-right-section">

            <div class="video-panel" id="videoPanel">

                @if (Model != null && Model.video != null)
                {
                    @Html.Action("ShowVideos", "Home", new { id = Model.video.VideoId })
                }
                else
                {
                    <div class="video-not-available">
                        <i class="fa-solid fa-video-slash fa-2x"></i>
                    </div>
                }

            </div>

            <div class="people-panel">

                <div class="people-header">
                    <div class="people-header-title">
                        <i class="fa fa-users"></i>
                        प्रतिनिधि / कर्मचारीहरु
                    </div>

                    <button type="button"
                            class="people-list-button"
                            id="openPeopleList"
                            title="सबै हेर्नुहोस्">
                        <i class="fa fa-list"></i>
                    </button>
                </div>

                <div class="person-display" id="personDisplay"></div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     PEOPLE LIST POPUP (filled by JavaScript)
     ========================================================= -->
<div class="people-list-modal" id="peopleListModal">
    <div class="people-list-dialog">

        <div class="people-list-header">
            <div>
                <i class="fa fa-users"></i>
                प्रतिनिधि / कर्मचारीहरुको सूची
            </div>
            <button type="button" class="people-list-close" id="closePeopleList">
                <i class="fa fa-times"></i>
            </button>
        </div>

        <div class="people-list-body">
            <div class="people-list-grid" id="peopleListGrid"></div>
        </div>

    </div>
</div>


<!-- =========================================================
     SERVICE DETAIL POPUP
     ========================================================= -->
<div class="service-detail-modal" id="serviceDetailModal">
    <div class="service-detail-dialog">

        <div class="service-detail-header">
            <div id="serviceDetailTitle">सेवा विवरण</div>
            <button type="button" class="service-detail-close" id="closeServiceDetail">
                <i class="fa fa-times"></i>
            </button>
        </div>

        <div class="service-detail-body">
            <table class="service-detail-table">
                <tbody>
                    <tr><th>सि.न.</th><td id="detailSerial"></td></tr>
                    <tr><th>सेवा सुविधाको नाम</th><td id="detailServiceName"></td></tr>
                    <tr><th>सेवा लिने प्रक्रिया</th><td id="detailProcess"></td></tr>
                    <tr><th>चाहिने कागजात</th><td id="detailDocuments"></td></tr>
                    <tr><th>लाग्ने सेवा शुल्क तथा दस्तुर</th><td id="detailFee"></td></tr>
                    <tr><th>लाग्ने समय</th><td id="detailTime"></td></tr>
                    <tr><th>जिम्मेवार पदाधिकारी</th><td id="detailOfficer"></td></tr>
                </tbody>
            </table>
        </div>

    </div>
</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           HELPERS (plain ES5 so older TV browsers work)
           ===================================================== */
        function each(list, fn) {
            Array.prototype.forEach.call(list, fn);
        }

        function el(id) {
            return document.getElementById(id);
        }

        function escapeHtml(value) {
            if (value === null || value === undefined) { return ""; }
            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        var NO_IMAGE = @Html.Raw(Json.Encode(noImage));

        function fixImages(container) {
            each(container.querySelectorAll("img"), function (img) {
                img.onerror = function () {
                    this.onerror = null;
                    this.src = NO_IMAGE;
                };
            });
        }


        /* =====================================================
           ELEMENTS
           ===================================================== */
        var searchInput = el("serviceSearch");
        var tableBody = el("serviceTableBody");
        var tableScroll = el("serviceTableScroll");

        var serviceDetailModal = el("serviceDetailModal");
        var closeServiceDetail = el("closeServiceDetail");
        var peopleListModal = el("peopleListModal");
        var openPeopleList = el("openPeopleList");
        var closePeopleList = el("closePeopleList");

        /* Tells the layout NOT to auto-reload while a popup is open. */
        function updateBusy() {
            window.__charterBusy =
                serviceDetailModal.style.display === "flex" ||
                peopleListModal.style.display === "flex";
        }


        /* =====================================================
           SERVICE DETAIL POPUP
           ===================================================== */
        function openServiceDetails(row) {

            var cells = row ? row.querySelectorAll("td") : [];

            if (cells.length < 6) { return; }

            el("detailSerial").innerHTML = cells[0].innerHTML;
            el("detailServiceName").innerHTML = cells[1].innerHTML;

            var processHtml = "";
            var documentHtml = "";

            each(cells[2].querySelectorAll(".service-detail"), function (detail) {

                var label = detail.querySelector(".detail-label");
                if (!label) { return; }

                var labelText = label.textContent.trim();
                var copy = detail.cloneNode(true);
                var copyLabel = copy.querySelector(".detail-label");

                if (copyLabel) { copyLabel.parentNode.removeChild(copyLabel); }

                if (labelText.indexOf("कागजात") !== -1) {
                    documentHtml += copy.innerHTML;
                }
                else {
                    processHtml += copy.innerHTML;
                }
            });

            if (!processHtml && !documentHtml) {
                processHtml = cells[2].innerHTML;
            }

            el("detailProcess").innerHTML = processHtml || "-";
            el("detailDocuments").innerHTML = documentHtml || "-";
            el("detailFee").innerHTML = cells[3].innerHTML;
            el("detailTime").innerHTML = cells[4].innerHTML;
            el("detailOfficer").innerHTML = cells[5].innerHTML;

            el("serviceDetailTitle").textContent =
                cells[1].textContent.trim() || "सेवा विवरण";

            serviceDetailModal.style.display = "flex";
            updateBusy();
        }

        function showAllRows() {
            if (!tableBody) { return; }
            each(tableBody.querySelectorAll(".service-row"), function (row) {
                row.style.display = "";
                row.className = row.className.replace(" search-match", "");
            });
            tableScroll.scrollTop = 0;
        }

        function clearSearch() {
            if (searchInput) { searchInput.value = ""; }
            showAllRows();
        }

        function closeServiceDetails() {
            serviceDetailModal.style.display = "none";
            clearSearch();            // restore the full table
            updateBusy();
        }

        if (closeServiceDetail) {
            closeServiceDetail.addEventListener("click", closeServiceDetails);
        }

        serviceDetailModal.addEventListener("click", function (event) {
            if (event.target === serviceDetailModal) { closeServiceDetails(); }
        });


        /* =====================================================
           SERVICE SEARCH
           - Filters the table.
           - If exactly one service matches (or the text is an
             exact serial number) its popup opens.
           - Waits 0.7 s after typing stops, so typing "10" does
             not open service 1 first.
           ===================================================== */
        function runSearch() {

            var q = searchInput.value.toLowerCase().trim();

            if (q === "") { showAllRows(); return; }

            var rows = tableBody.querySelectorAll(".service-row");
            var exact = null;
            var matches = [];

            each(rows, function (row) {
                var s = row.querySelector(".serial-number");
                if (s && s.textContent.trim() === q) { exact = row; }
            });

            each(rows, function (row) {

                row.className = row.className.replace(" search-match", "");

                var hit = exact
                    ? row === exact
                    : row.textContent.toLowerCase().indexOf(q) !== -1;

                row.style.display = hit ? "" : "none";

                if (hit) { matches.push(row); }
            });

            tableScroll.scrollTop = 0;

            if (matches.length === 1) {
                matches[0].className += " search-match";
                openServiceDetails(matches[0]);
            }
        }

        if (searchInput && tableBody) {

            var searchTimer = null;

            searchInput.addEventListener("input", function () {

                clearTimeout(searchTimer);

                if (this.value.trim() === "") {
                    showAllRows();
                    return;
                }

                searchTimer = setTimeout(runSearch, 700);
            });

            searchInput.addEventListener("keydown", function (event) {
                if (event.keyCode === 13) {      // Enter = search now
                    clearTimeout(searchTimer);
                    runSearch();
                }
            });

            tableBody.addEventListener("click", function (event) {

                var node = event.target;

                while (node && node !== tableBody) {
                    if (node.className && String(node.className).indexOf("service-row") !== -1) {
                        break;
                    }
                    node = node.parentNode;
                }

                if (node && node !== tableBody && searchInput.value.trim() !== "") {
                    openServiceDetails(node);
                }
            });
        }


        /* =====================================================
           TABLE AUTO SCROLL
           - Frame based, speed measured in rem per second, so it
             looks the same on 1080p and 4K.
           - Holds 4 seconds at the bottom and at the top.
           - Does NOT stop on mouse hover (a TV pointer could
             freeze it). Touch / wheel pause it for 8 seconds.
           ===================================================== */
        if (tableScroll) {

            var SPEED_REM = 2.2;           // rem per second
            var HOLD_MS = 4000;
            var USER_PAUSE_MS = 8000;

            var pos = 0;
            var lastTime = 0;
            var pauseUntil = 0;

            function userTouched() {
                pauseUntil = Date.now() + USER_PAUSE_MS;
            }

            tableScroll.addEventListener("wheel", userTouched);
            tableScroll.addEventListener("touchstart", userTouched);
            tableScroll.addEventListener("mousedown", userTouched);

            function step() {

                var now = Date.now();
                var dt = lastTime ? (now - lastTime) / 1000 : 0;
                lastTime = now;

                var max = tableScroll.scrollHeight - tableScroll.clientHeight;

                if (max > 0 && now > pauseUntil && !window.__charterBusy) {

                    // somebody scrolled manually -> continue from there
                    if (Math.abs(tableScroll.scrollTop - pos) > 3) {
                        pos = tableScroll.scrollTop;
                    }

                    var rem = parseFloat(window.getComputedStyle(document.documentElement).fontSize) || 16;

                    if (pos >= max - 1) {
                        pos = 0;                         // back to top, hold
                        pauseUntil = now + HOLD_MS;
                    }
                    else {
                        pos = Math.min(max, pos + SPEED_REM * rem * dt);
                        if (pos >= max - 1) { pauseUntil = now + HOLD_MS; }   // reached bottom, hold
                    }

                    tableScroll.scrollTop = pos;
                }

                window.requestAnimationFrame(step);
            }

            window.requestAnimationFrame(step);
        }


        /* =====================================================
           PEOPLE (representatives + employees)
           ===================================================== */
        var people = @Html.Raw(Json.Encode(peopleData));

        var personDisplay = el("personDisplay");
        var currentPersonIndex = 0;

        function showPerson(index) {

            if (!personDisplay) { return; }

            if (people.length === 0) {
                personDisplay.innerHTML =
                    '<div class="no-service"><div>' +
                    '<i class="fa fa-user fa-2x"></i><br><br>' +
                    'हाल कुनै प्रतिनिधि / कर्मचारी उपलब्ध छैन।' +
                    '</div></div>';
                return;
            }

            var p = people[index];

            var html =
                '<div class="person-card">' +
                    '<div class="person-image-wrapper">' +
                        '<img class="person-image" src="' + escapeHtml(p.image) + '" alt="' + escapeHtml(p.name) + '">' +
                    '</div>' +
                    '<div class="person-name">' + escapeHtml(p.name) + '</div>' +
                    '<div class="person-post">' + escapeHtml(p.post) + '</div>';

            if (p.contact) {
                html += '<div class="person-contact"><i class="fa fa-phone"></i>' + escapeHtml(p.contact) + '</div>';
            }

            html +=
                    '<div class="person-type">' + escapeHtml(p.type) + '</div>' +
                    '<div class="person-counter">' + (index + 1) + ' / ' + people.length + '</div>' +
                '</div>';

            personDisplay.innerHTML = html;
            fixImages(personDisplay);
        }

        showPerson(0);

        if (people.length > 1) {
            setInterval(function () {
                currentPersonIndex = (currentPersonIndex + 1) % people.length;
                showPerson(currentPersonIndex);
            }, 6000);
        }


        /* =====================================================
           PEOPLE LIST POPUP
           ===================================================== */
        function buildPeopleList() {

            var grid = el("peopleListGrid");

            if (!grid || grid.getAttribute("data-built")) { return; }

            var html = "";

            people.forEach(function (p) {
                html +=
                    '<div class="people-list-item"><div class="people-list-card">' +
                        '<img class="people-list-image" src="' + escapeHtml(p.image) + '" alt="' + escapeHtml(p.name) + '">' +
                        '<div class="people-list-text">' +
                            '<div class="people-list-name">' + escapeHtml(p.name) + '</div>' +
                            '<div class="people-list-post">' + escapeHtml(p.post) + '</div>' +
                            (p.contact
                                ? '<div class="people-list-contact"><i class="fa fa-phone"></i> ' + escapeHtml(p.contact) + '</div>'
                                : '') +
                        '</div>' +
                    '</div></div>';
            });

            grid.innerHTML = html;
            fixImages(grid);
            grid.setAttribute("data-built", "1");
        }

        function closePeopleModal() {
            peopleListModal.style.display = "none";
            updateBusy();
        }

        if (openPeopleList) {
            openPeopleList.addEventListener("click", function () {
                buildPeopleList();
                peopleListModal.style.display = "flex";
                updateBusy();
            });
        }

        if (closePeopleList) {
            closePeopleList.addEventListener("click", closePeopleModal);
        }

        peopleListModal.addEventListener("click", function (event) {
            if (event.target === peopleListModal) { closePeopleModal(); }
        });


        /* =====================================================
           CLOSE KEYS
           Escape (keyboard), 461 (LG webOS Back), 10009 (Samsung
           Tizen Back).
           ===================================================== */
        document.addEventListener("keydown", function (event) {

            var k = event.keyCode;

            if (event.key === "Escape" || k === 27 || k === 461 || k === 10009) {
                closeServiceDetails();
                closePeopleModal();
            }
        });


        /* =====================================================
           IDLE RESET
           If nobody touches the screen for 60 seconds: clear the
           search and close any popup, so the board always returns
           to the normal scrolling display.
           ===================================================== */
        var idleTimer = null;

        function resetIdle() {
            clearTimeout(idleTimer);
            idleTimer = setTimeout(function () {
                closeServiceDetails();
                closePeopleModal();
            }, 60000);
        }

        ["keydown", "click", "touchstart", "wheel"].forEach(function (name) {
            document.addEventListener(name, resetIdle);
        });

        resetIdle();

    });

</script>

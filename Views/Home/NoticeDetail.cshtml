@model HelpDesk.Models.Notice
@{
    Layout = "~/Views/Shared/_WebSiteLayout.cshtml";

    var ofc = Utility.officeDetail();

    int count = 1;
    int num = 0;

}
<style>

    .carousel-item {
        width: 100%;
        height: 700px;
    }

    .news-description {
        font-family: Kalimati !important;
        text-align: justify;
        padding: 20px;
        background-color: whitesmoke;
    }

    .notice-image {
        height: 90vh;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }
</style>
<div>

    <div class="row">
        <div class="col-md-12">

            <div id="carouselExampleDark" class="carousel carousel-dark slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @foreach (var item in Model.NoticeFiles.lists.ToList())
                    {
                        if (num == 0)
                        {
                            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="@num" class="active" aria-current="true" aria-label="Slide 1"></button>
                        }
                        else
                        {
                            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="@num" aria-label="Slide 2"></button>
                        }
                        num++;
                    }
                </div>
                <div class="carousel-inner">

                    @foreach (var item in Model.NoticeFiles.lists.ToList())
                    {
                        if (count == 1)
                        {
                            <div class="carousel-item active" data-bs-interval="4000">
                                <img src="~/Notice_Upload/@item.Image" class="d-block w-100" alt="...">

                            </div>
                        }
                        else
                        {
                            <div class="carousel-item" data-bs-interval="4000">
                                <img src="~/Notice_Upload/@item.Image" class="d-block w-100" alt="...">

                            </div>
                        }
                        count++;
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleDark" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleDark" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
            <hr />
            <div class="news-description">
                <h4 style="text-align: center"><b><i class="fa-solid fa-file-pen"></i> @Model.Title</b></h4>
                @Model.Description
                <br />
                <h6 style="text-align:right"><b><i class="fa-solid fa-calendar-days"></i> @Model.CreateDate</b></h6>
            </div>

        </div>
        <!-- Latest update -->

    </div>

</div>
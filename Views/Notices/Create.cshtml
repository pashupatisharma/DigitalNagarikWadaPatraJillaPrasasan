@model HelpDesk.Models.Notice


<script src="~/Adminscripts/ckeditor/ckeditor.js"></script>
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_LayOut.cshtml";
}


<div class="row">

    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="card-header bg-info">
                    <h4 class="m-b-0 text-white">News Information</h4>
                </div>

                @using (Html.BeginForm("Create", "Notices", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-body">

                        <hr>

                        <div class="row">
                            @Html.ValidationSummary(true)

                            <div class="col-md-6">
                                <label>Select File<span class="required">*</span></label>
                                <input type="file" name="Imagefile" class="form-control bordered-input" onchange="ChangeImage(this)" multiple />
                                @Html.ValidationMessageFor(m => m.NoticeFiles.Image, "", new { @class = "text-danger" })

                                @if (Model.NoticeFiles.Image != null)
                                {
                                    <img src="~/Notice_Upload/@Model.NoticeFiles.Image" , id="imgThumbnail" class="form-control bordered-input" style="width: 60px; height: 60px " />
                                }
                                else

                                {
                                    <img src="~/Content/images/UserImage.png" id="imgThumbnail" class="form-control bordered-input" style="width: 70px; height: 60px " />
                                }
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(model => model.CreateDate)

                                @Html.TextBoxFor(model => model.CreateDate, new { @class = "form-control nepali-calendar bordered-input" })
                                @Html.ValidationMessageFor(model => model.CreateDate)
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.Title)

                                @Html.TextBoxFor(model => model.Title, new { @class = "form-control bordered-input" })
                                @Html.ValidationMessageFor(model => model.Title)
                            </div>


                            <div class="col-md-6">
                                @Html.LabelFor(model => model.Description)

                                @Html.TextAreaFor(model => model.Description, new { @class = "ckeditor", @style = "width:500px;height:200px" })
                                @Html.ValidationMessageFor(model => model.Description)
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-success text-white"> <i class="fa fa-check"></i> Save</button>
                                <button type="button" class="btn btn-inverse">Cancel</button>
                            </div>
                        </div>
                    </div>

                }

                <div>
                    @Html.ActionLink("Back to List", "Index")
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        var k = jQuery.noConflict();

        k(document).ready(function () {
            k(".chosen-select").chosen({
                no_result_text: "Oops Something went wrong !!",
            });
            k('.nepali-calendar').nepaliDatePicker();
        });

        function ChangeImage(input) {
            //alert(input);
            if (input.files && input.files[0]) {
                var ImageDir = new FileReader();
                ImageDir.onload = function (e) {
                    k('#imgThumbnail').attr('src', e.target.result);
                }
                ImageDir.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
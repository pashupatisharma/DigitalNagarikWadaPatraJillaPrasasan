@model HelpDesk.Models.Notice
@{
    Layout = "~/Views/Shared/_LayOut.cshtml";
}
<div class="row page-titles">
    <div class="col-md-5 align-self-center">
        <h4 class="text-themecolor">सूचना सुची</h4>
    </div>
    <div class="col-md-7 align-self-center text-end">
        <div class="d-flex justify-content-end align-items-center">
            <ol class="breadcrumb justify-content-end">
                <li class="breadcrumb-item"><a href="javascript:void(0)">Home</a></li>
                <li class="breadcrumb-item active">सूचना</li>
            </ol>
            <button type="button" class="btn btn-info d-none d-lg-block m-l-15 text-white" onclick="location.href = '@Url.Action("Create","Notices")'"><i class="fa fa-plus-circle"></i> Create Notice</button>


        </div>
    </div>
</div>


@using (Html.BeginForm("Create", "Notices", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header bg-info">
                    <h4 class="m-b-0 text-white">ADD</h4>
                </div>
                <div class="card-body">
                    <div class="body_blocks top">
                        @if (Model.Lists.Any())
                        {
                            int i = 1;
                            <div class="table-responsive">
                                <table class="table color-table success-table">
                                    <thead>
                                        <tr class="strong">

                                            <td>S.N</td>
                                            <td>Title</td>
                                            <td>Description</td>
                                            <td>Action</td>


                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.Lists)
                                        {
                                            <tr class="background">

                                                <td>@i</td>
                                                <td>@item.Title</td>
                                                <td>@item.Description</td>

                                                <td>

                                                    <a href="@Url.Action("Edit", "Notices", new { @id = item.NoticeId })">
                                                        Edit
                                                    </a>

                                                    @Html.ActionLink(
                                                    "Delete",
                                                    "Delete",
                                                    "Notices",
                                                    new
                                                    {
                                                        @id = item.NoticeId
                                                    },
                                                    new
                                                    {
                                                        onclick = "return confirm('Are you sure you want to delete ?');"
                                                    }
                                                )
                                                </td>





                                            </tr>
                                            i++;
                                        }

                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <h3>No any Record Found</h3>
                        }

                    </div>

                </div>
            </div>
        </div>
    </div>


}

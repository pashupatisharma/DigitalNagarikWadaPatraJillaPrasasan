@{
    Layout = null;

    // Always send UTF-8 so Nepali (Devanagari) text is never garbled
    Response.Charset = "utf-8";

    // ---------------------------------------------------------
    // KIOSK MODE (TV)
    // Open the display as  http://yoursite/Home/WebIndex?kiosk=1
    // Kiosk mode hides Login and Fullscreen buttons, hides the
    // mouse pointer and disables the emblem link.
    // TOUCH STAYS ENABLED: the TV screen can be touched to
    // scroll, open service details, search and open the people list.
    // ---------------------------------------------------------
    bool kiosk = Request.QueryString["kiosk"] == "1";

    // ---------------------------------------------------------
    // OFFICE + NOTICES (context is disposed straight away)
    // ---------------------------------------------------------
    var ofcname = string.Empty;
    var pradesh = string.Empty;
    var minsitry = string.Empty;
    var adress = string.Empty;

    var ofc = Utility.officeDetail();
    if (ofc != null)
    {
        ofcname = ofc.Office_Name ?? string.Empty;
        pradesh = ofc.Pradesh ?? string.Empty;
        minsitry = ofc.Ministry ?? string.Empty;
        adress = ofc.Office_Location ?? string.Empty;
    }

    // Header line 1 must read "कर्णाली प्रदेश सरकार"
    // (adds "सरकार" if the database only stores "कर्णाली प्रदेश")
    var pradeshLine = pradesh.Trim();
    if (pradeshLine.Length > 0 && !pradeshLine.Contains("सरकार"))
    {
        pradeshLine = pradeshLine + " सरकार";
    }

    var db = new HelpDesk.Models.ApplicationDbContext();
    var notice = db.Notice
        .OrderByDescending(x => x.NoticeId)
        .Take(5)
        .ToList();
    db.Dispose();
}
<!DOCTYPE html>
<html lang="ne">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <!-- zoom is blocked so a finger pinch / double tap can't break the TV layout -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <title>
        @if (ofc != null)
        {
            @ofc.Office_Name
        }
        else
        {
            <text>डिजिटल नागरिक वडापत्र प्रणाली</text>
        }
    </title>

    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/fontawesome-free-6.7.2-web/css/all.css" rel="stylesheet" />
    <link href="~/Styles/style.css" rel="stylesheet" />
    <link href="~/css/asstes/css/styles.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

    <style>

        /* =====================================================
           KALIMATI FONT (self-hosted, served to every browser/TV)
           Files in  /Content/fonts/
               Kalimati.woff2
               Kalimati.woff
               Kalimati.otf      <- if your file is .ttf, change the
                                    last line of src to .ttf + format("truetype")
           Kalimati has only ONE weight. It is declared for 400 and
           700 with the same file so the browser never fakes a
           second (blurry) bold.
           ===================================================== */
        @@font-face {
            font-family: "Kalimati";
            font-style: normal;
            font-weight: 400;
            font-display: swap;
            src: url('@Url.Content("~/Content/fonts/Kalimati.woff2")') format("woff2"),
                 url('@Url.Content("~/Content/fonts/Kalimati.woff")') format("woff"),
                 url('@Url.Content("~/Content/fonts/Kalimati.otf")') format("opentype");
        }

        @@font-face {
            font-family: "Kalimati";
            font-style: normal;
            font-weight: 700;
            font-display: swap;
            src: url('@Url.Content("~/Content/fonts/Kalimati.woff2")') format("woff2"),
                 url('@Url.Content("~/Content/fonts/Kalimati.woff")') format("woff"),
                 url('@Url.Content("~/Content/fonts/Kalimati.otf")') format("opentype");
        }

        /* Force Kalimati everywhere (bootstrap / style.css / styles.css
           set their own font-family). Font Awesome <i> icons are not
           in this list, so icons keep working. */
        body, div, span, p, a, strong, b, label, th, td, button,
        input, select, textarea, h1, h2, h3, h4, h5, h6 {
            font-family: "Kalimati", "Noto Sans Devanagari", "Mangal", "Segoe UI", Arial, sans-serif !important;
        }

        /* =====================================================
           SCALING
           1rem = 16px on 1920x1080, 32px on 3840x2160.
           Everything is written in rem, so the whole board
           scales to any TV size (32" to 75"+).
           ===================================================== */
        html {
            font-size: .8333vw !important;
        }

        @@supports (font-size: min(1vw, 1vh)) {
            html {
                font-size: min(.8333vw, 1.4815vh) !important;
            }
        }

        html, body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        html {
            -webkit-tap-highlight-color: transparent;
        }

        body {
            display: -webkit-flex;
            display: flex;
            -webkit-flex-direction: column;
            flex-direction: column;
            box-sizing: border-box;
            /* thin frame = safe margin against TV overscan */
            padding: .3rem .5rem;
            overflow: hidden !important;
            background: #0f1f3d;
            font-size: 1rem;
            line-height: 1.4;
            /* touch: allow finger scrolling, block pinch-zoom / double-tap zoom */
            -ms-touch-action: pan-x pan-y;
            touch-action: pan-x pan-y;
        }

        /* =====================================================
           HEADER  (white board, red Kalimati text - as in header_format)
             Line 1  Pradesh Sarkar
             Line 2  Ministry
             Line 3  Office name (largest)
             Line 4  Address
           ===================================================== */
        .tv-header {
            position: relative;
            flex: 0 0 auto;
            display: -webkit-flex;
            display: flex;
            -webkit-align-items: center;
            align-items: center;
            min-height: 8.6rem;
            padding: .35rem 3.6rem .35rem .8rem;
            box-sizing: border-box;
            background: #ffffff;
            border-left: .4rem solid #c9a227;
            border-bottom: .3rem solid #c9a227;
            box-shadow: 0 .25rem 1rem rgba(0,0,0,.25);
            overflow: hidden;
        }

        .office-logo {
            flex: 0 0 13rem;
            width: 13rem;
            display: -webkit-flex;
            display: flex;
            -webkit-align-items: center;
            align-items: center;
            -webkit-justify-content: center;
            justify-content: center;
        }

        .nepal-emblem {
            display: block;
            height: 6rem;
            width: auto;
            max-width: 9rem;
            -o-object-fit: contain;
            object-fit: contain;
        }

        .office-header-content {
            flex: 1 1 auto;
            min-width: 0;
            padding: 0 .6rem;
            text-align: center;
            color: #e30000;
        }

        .office-pradesh {
            font-size: 1.5rem;
            font-weight: 400;
            line-height: 1.3;
        }

        .office-ministry {
            font-size: 1.8rem;
            font-weight: 400;
            line-height: 1.3;
        }

        .office-name {
            font-size: 3.4rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .office-address {
            font-size: 1.55rem;
            font-weight: 400;
            line-height: 1.3;
        }

        .office-right {
            flex: 0 0 13rem;
            width: 13rem;
            display: -webkit-flex;
            display: flex;
            -webkit-flex-direction: column;
            flex-direction: column;
            -webkit-align-items: center;
            align-items: center;
            -webkit-justify-content: center;
            justify-content: center;
            text-align: center;
            color: #172554;
        }

        .nepal-flag {
            height: 3rem;
            width: auto;
        }

        .header-date {
            margin-top: .2rem;
            font-size: .95rem;
            font-weight: 600;
            line-height: 1.2;
        }

        .header-time {
            font-size: 1.3rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .login-button {
            display: inline-block;
            margin-top: .25rem;
            padding: .15rem 1rem;
            color: #fff !important;
            background: #9b111e;
            border: 1px solid #9b111e;
            border-radius: .3rem;
            text-decoration: none !important;
            font-size: .9rem;
            font-weight: 600;
        }

        .fullscreen-button {
            position: absolute;
            top: .5rem;
            right: .5rem;
            width: 2.6rem;
            height: 2.6rem;
            border: 1px solid #cbd5e1;
            border-radius: 50%;
            background: #f1f5f9;
            color: #172554;
            font-size: 1.4rem;
            line-height: 1;
            cursor: pointer;
            z-index: 5;
        }

        /* =====================================================
           MAIN AREA
           ===================================================== */
        .website-main {
            flex: 1 1 auto;
            min-height: 0;
            display: -webkit-flex;
            display: flex;
            -webkit-flex-direction: column;
            flex-direction: column;
            background: #eef2f7;
            overflow: hidden;
        }

        .website-content {
            flex: 1 1 auto;
            min-height: 0;
            display: -webkit-flex;
            display: flex;
            -webkit-flex-direction: column;
            flex-direction: column;
            overflow: hidden;
            background: #eef2f7;
        }

        /* =====================================================
           FOOTER + NOTICE BAR
           ===================================================== */
        .website-footer {
            flex: 0 0 auto;
            background: #0f1f3d;
            color: #fff;
            border-top: .2rem solid #c9a227;
        }

        .notice-bar {
            display: -webkit-flex;
            display: flex;
            -webkit-align-items: stretch;
            align-items: stretch;
            min-height: 2.6rem;
            background: linear-gradient(90deg, #0f1f3d, #172554, #1e3a5f);
            color: #fff;
            overflow: hidden;
        }

        .notice-title {
            flex: 0 0 auto;
            display: -webkit-flex;
            display: flex;
            -webkit-align-items: center;
            align-items: center;
            padding: 0 1.2rem;
            background: #9b111e;
            font-size: 1.2rem;
            font-weight: 700;
            white-space: nowrap;
        }

            .notice-title i {
                margin-right: .5rem;
            }

        .notice-marquee {
            flex: 1 1 auto;
            min-width: 0;
            display: -webkit-flex;
            display: flex;
            -webkit-align-items: center;
            align-items: center;
            overflow: hidden;
        }

        /* Smooth CSS ticker (replaces <marquee>). Duration is
           calculated in JavaScript so speed is the same on any TV. */
        .notice-track {
            flex: 0 0 auto;
            display: inline-block;
            padding-left: 100%;
            white-space: nowrap;
            font-size: 1.25rem;
            -webkit-animation: ticker 40s linear infinite;
            animation: ticker 40s linear infinite;
        }

        @@-webkit-keyframes ticker {
            0% {
                -webkit-transform: translateX(0);
            }

            100% {
                -webkit-transform: translateX(-100%);
            }
        }

        @@keyframes ticker {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-100%);
            }
        }

        .notice-item {
            display: inline-block;
            margin-right: 4rem;
            color: #fff;
        }

            .notice-item::before {
                content: "\2022";
                margin-right: .6rem;
                color: #ffe08a;
                font-weight: 700;
            }

        /* big enough for a finger */
        .notice-audio {
            flex: 0 0 auto;
            width: 3.4rem;
            border: 0;
            background: #172554;
            color: #fff;
            font-size: 1.3rem;
            cursor: pointer;
        }

        .notice-audio:active {
            background: #1e3a5f;
        }

        .footer-info {
            display: -webkit-flex;
            display: flex;
            padding: .35rem 1rem;
            font-size: 1rem;
            line-height: 1.35;
            color: #fff;
        }

            .footer-info > div {
                -webkit-flex: 1 1 0;
                flex: 1 1 0;
                min-width: 0;
            }

        .footer-office {
            font-weight: 700;
        }

        .footer-center {
            text-align: center;
        }

        .footer-developed {
            text-align: right;
        }

        /* =====================================================
           KIOSK MODE (?kiosk=1)
           - Login + Fullscreen hidden (public must not reach them)
           - Mouse pointer hidden
           - Touch is ENABLED: search, people list, audio button and
             service rows all stay tappable.
           - Long-press text selection / callout disabled.
           ===================================================== */
        .kiosk .login-button,
        .kiosk .fullscreen-button {
            display: none !important;
        }

        .kiosk .tv-header {
            padding-right: 1rem;
        }

        .kiosk .office-logo a {
            pointer-events: none;
        }

        .kiosk, .kiosk * {
            cursor: none;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            -webkit-touch-callout: none;
        }

        /* the search box must still accept typing */
        .kiosk input {
            -webkit-user-select: text;
            -moz-user-select: text;
            -ms-user-select: text;
            user-select: text;
        }
    </style>
</head>

<body class="@(kiosk ? "kiosk" : "")">

    <!-- =====================================================
         HEADER
         ===================================================== -->
    <header class="tv-header">

        <div class="office-logo">
            <a href="@Url.Action("Index", "Home")">
                <img src="~/Content/Image/Emblem_of_Nepal.png"
                     class="nepal-emblem"
                     alt="नेपाल सरकारको प्रतीक" />
            </a>
        </div>

        <div class="office-header-content">

            @if (!string.IsNullOrWhiteSpace(pradeshLine))
            {
                <div class="office-pradesh">@pradeshLine</div>
            }

            @if (!string.IsNullOrWhiteSpace(minsitry))
            {
                <div class="office-ministry">@minsitry</div>
            }

            @if (!string.IsNullOrWhiteSpace(ofcname))
            {
                <div class="office-name">@ofcname</div>
            }

            @if (!string.IsNullOrWhiteSpace(adress))
            {
                <div class="office-address">@adress</div>
            }

        </div>

        <div class="office-right">

            <img src="~/Content/Image/animated-nepal-flag-image-0004.gif"
                 class="nepal-flag"
                 alt="नेपालको राष्ट्रिय झण्डा" />

            <!-- Live date and time (updated by JavaScript, so it never goes stale) -->
            <div class="header-date" id="hdrDate"></div>
            <div class="header-time" id="hdrTime"></div>

            <a href="@Url.Action("Login", "Account")"
               class="login-button"
               target="_blank">Login</a>

        </div>

        <button type="button"
                class="fullscreen-button"
                onclick="toggleFullscreen()"
                title="Full Screen">
            &#x26F6;
        </button>

    </header>


    <!-- =====================================================
         PAGE CONTENT + FOOTER
         ===================================================== -->
    <section class="website-main">

        <div class="website-content">
            @RenderBody()
        </div>

        <footer class="website-footer">

            <!-- NOTICE BAR (always visible) -->
            <div class="notice-bar">

                <div class="notice-title">
                    <i class="fa fa-bullhorn" aria-hidden="true"></i>
                    <span>सूचना</span>
                </div>

                <div class="notice-marquee">
                    <div class="notice-track" id="noticeTrack">
                        @if (notice != null && notice.Count > 0)
                        {
                            foreach (var item in notice)
                            {
                                <span class="notice-item">@item.Title</span>
                            }
                        }
                        else
                        {
                            <span class="notice-item">हाल कुनै सूचना उपलब्ध छैन।</span>
                        }
                    </div>
                </div>

                <button type="button"
                        id="enableWebsiteAudio"
                        class="notice-audio"
                        title="संगीत सुरु गर्नुहोस्"
                        aria-label="संगीत सुरु गर्नुहोस्">
                    <i class="fa-solid fa-volume-xmark"></i>
                </button>

            </div>

            <!-- FOOTER INFORMATION -->
            <div class="footer-info">

                <div>
                    <div class="footer-office">
                        @if (ofc != null)
                        {
                            @ofc.Office_Name
                        }
                    </div>
                    @if (ofc != null)
                    {
                        <div>@ofc.Office_Location</div>
                    }
                </div>

                <div class="footer-center">
                    <div>डिजिटल नागरिक वडापत्र प्रणाली</div>
                    <div>&copy; @DateTime.Now.Year All Rights Reserved.</div>
                </div>

                <div class="footer-developed">
                    <div>Developed By <strong>APOGEE</strong></div>
                    <div>Think Digital. Think Apogee.</div>
                </div>

            </div>

        </footer>

    </section>


    <!-- =====================================================
         BACKGROUND AUDIO
         NOTE: if the video in WebIndex also has sound, mute one
         of them, otherwise both will play together.
         ===================================================== -->
    <audio id="websiteBackgroundAudio" loop="loop" preload="auto">
        <source src="@Url.Content("~/Content/Audio/background.mp3")" type="audio/mpeg" />
    </audio>


    <script>

        var isKiosk = @(kiosk ? "true" : "false");

        /* ---------------------------------------------------
           KIOSK + TOUCH: a long press on a touch TV opens the
           browser's context menu - block it.
           --------------------------------------------------- */
        if (isKiosk) {
            document.addEventListener("contextmenu", function (e) {
                e.preventDefault();
            });
        }

        /* ---------------------------------------------------
           FULLSCREEN (normal browser use)
           --------------------------------------------------- */
        function toggleFullscreen() {
            var el = document.documentElement;
            var isFull = document.fullscreenElement || document.webkitFullscreenElement;

            if (!isFull) {
                if (el.requestFullscreen) { el.requestFullscreen(); }
                else if (el.webkitRequestFullscreen) { el.webkitRequestFullscreen(); }
                else if (el.msRequestFullscreen) { el.msRequestFullscreen(); }
            }
            else {
                if (document.exitFullscreen) { document.exitFullscreen(); }
                else if (document.webkitExitFullscreen) { document.webkitExitFullscreen(); }
                else if (document.msExitFullscreen) { document.msExitFullscreen(); }
            }
        }


        /* ---------------------------------------------------
           LIVE DATE + TIME
           --------------------------------------------------- */
        (function () {

            var DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            var MONTHS = ["January", "February", "March", "April", "May", "June",
                          "July", "August", "September", "October", "November", "December"];

            function pad(n) { return n < 10 ? "0" + n : "" + n; }

            function tick() {
                var n = new Date();
                var h = n.getHours();
                var ap = h >= 12 ? "PM" : "AM";
                h = h % 12; if (h === 0) { h = 12; }

                var d = document.getElementById("hdrDate");
                var t = document.getElementById("hdrTime");

                if (d) { d.textContent = DAYS[n.getDay()] + ", " + n.getDate() + " " + MONTHS[n.getMonth()] + " " + n.getFullYear(); }
                if (t) { t.textContent = pad(h) + ":" + pad(n.getMinutes()) + ":" + pad(n.getSeconds()) + " " + ap; }
            }

            tick();
            setInterval(tick, 1000);

        })();


        /* ---------------------------------------------------
           NOTICE TICKER SPEED
           Constant speed (8 rem per second) on every screen size.
           --------------------------------------------------- */
        (function () {

            function setTicker() {
                var track = document.getElementById("noticeTrack");
                if (!track) { return; }

                var rem = parseFloat(window.getComputedStyle(document.documentElement).fontSize) || 16;
                var secs = Math.max(15, track.scrollWidth / (rem * 8));

                track.style.webkitAnimationDuration = secs + "s";
                track.style.animationDuration = secs + "s";
            }

            window.addEventListener("load", setTicker);
            window.addEventListener("resize", setTicker);

            /* the ticker width changes once Kalimati has finished loading */
            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(setTicker);
            }

        })();


        /* ---------------------------------------------------
           SCHEDULED REFRESH
           Reloads the page every 30 minutes so new notices,
           services, people and videos appear on the TV.
           Skipped while a popup is open (set by WebIndex).
           --------------------------------------------------- */
        setInterval(function () {
            if (!window.__charterBusy) {
                window.location.reload();
            }
        }, 30 * 60 * 1000);


        /* ---------------------------------------------------
           BACKGROUND AUDIO
           - Kiosk: tries to start automatically. If the TV
             browser blocks autoplay, the FIRST TOUCH on the
             screen starts the music.
           - The speaker button (touch or click) turns it on/off.
           --------------------------------------------------- */
        (function () {

            var audio = document.getElementById("websiteBackgroundAudio");
            var btn = document.getElementById("enableWebsiteAudio");

            if (!audio) { return; }

            audio.volume = 0.35;

            var on = false;
            var manualOff = false;

            function paint() {
                if (!btn) { return; }
                var icon = btn.querySelector("i");
                var text = on ? "संगीत बन्द गर्नुहोस्" : "संगीत सुरु गर्नुहोस्";
                if (icon) { icon.className = on ? "fa-solid fa-volume-high" : "fa-solid fa-volume-xmark"; }
                btn.title = text;
                btn.setAttribute("aria-label", text);
            }

            function play() {
                var p = audio.play();
                if (p && p.then) {
                    p.then(function () { on = true; paint(); })
                     .catch(function () { on = false; paint(); });
                }
                else {
                    on = !audio.paused;
                    paint();
                }
            }

            function firstInteraction() {
                if (!on && !manualOff) { play(); }
            }

            if (btn) {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    if (on) {
                        audio.pause();
                        audio.currentTime = 0;
                        on = false;
                        manualOff = true;
                        paint();
                    }
                    else {
                        manualOff = false;
                        play();
                    }
                });
            }

            document.addEventListener("click", firstInteraction);
            document.addEventListener("touchstart", firstInteraction);
            document.addEventListener("keydown", firstInteraction);

            paint();

            if (isKiosk) { play(); }

        })();

    </script>

</body>
</html>

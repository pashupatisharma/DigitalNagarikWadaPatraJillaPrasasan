@model HelpDesk.Models.Offices
@using HelpDesk.Helpers;
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("Create", "Offices", FormMethod.Post, new { id = "form0", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
   
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <hr />
                <div class="card-header bg-info">
                    <h4 class="m-b-0 text-white">कार्यालय</h4>
                </div>
                <div class="card-body">



                    <div class="row">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })


                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                            @Html.LabelFor(model => model.Office_Code)

                            @Html.EditorFor(model => model.Office_Code, new { htmlAttributes = new { @class = "form-control bordered-input" } })
                            @Html.ValidationMessageFor(model => model.Office_Code, "", new { @class = "text-danger" })
                        </div>



                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                            @Html.LabelFor(model => model.Office_Name)

                            @Html.EditorFor(model => model.Office_Name, new { htmlAttributes = new { @class = "form-control bordered-input" } })
                            @Html.ValidationMessageFor(model => model.Office_Name, "", new { @class = "text-danger" })
                        </div>




                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                            @Html.LabelFor(model => model.Office_Location) 
                            @Html.EditorFor(model => model.Office_Location, new { htmlAttributes = new { @class = "form-control bordered-input" } })
                            @Html.ValidationMessageFor(model => model.Office_Location, "", new { @class = "text-danger" })
                        </div>



                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                            @Html.LabelFor(model => model.Office_Phone)

                            @Html.EditorFor(model => model.Office_Phone, new { htmlAttributes = new { @class = "form-control bordered-input" } })
                            @Html.ValidationMessageFor(model => model.Office_Phone, "", new { @class = "text-danger" })
                        </div>



                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                            @Html.LabelFor(model => model.Office_URL)

                            @Html.EditorFor(model => model.Office_URL, new { htmlAttributes = new { @class = "form-control bordered-input" } })
                            @Html.ValidationMessageFor(model => model.Office_URL, "", new { @class = "text-danger" })
                        </div>



                        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                            @Html.LabelFor(model => model.Office_Email)

                            @Html.EditorFor(model => model.Office_Email, new { htmlAttributes = new { @class = "form-control bordered-input" } })
                            @Html.ValidationMessageFor(model => model.Office_Email, "", new { @class = "text-danger" })
                        </div>



                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            @Html.LabelFor(model => model.Message)

                            @Html.EditorFor(model => model.Message, new { htmlAttributes = new { @class = "form-control bordered-input" } })
                            @Html.ValidationMessageFor(model => model.Message, "", new { @class = "text-danger" })
                        </div>





                    </div>
                    <div></div><br />
              
                    <div></div><br />
                    <div class="row">
                        <div class="form-actions text-right">
                            <button class="btn btn-info" type="submit">
                                <i class="ace-icon fa fa-check bigger-110"></i>
                                 बचत
                            </button>


                            <button class="btn btn-reset" type="reset">
                                <i class="ace-icon fa fa-undo bigger-110"></i>
                                Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

@model List<HelpDesk.Models.AppUser>
@{
    ViewBag.Title = "प्रयोगकर्ताको सूची ";
    int SNo = 0;
}



<div class="row page-titles">

    <div class="col-md-12 align-self-right text-end">
        <div class="d-flex justify-content-end align-items-center">
            <ol class="breadcrumb justify-content-end">
                <li class="breadcrumb-item"><a href="javascript:void(0)">Home</a></li>
                <li class="breadcrumb-item active">प्रयोगकर्ता </li>
                <li class="breadcrumb-item">
                    <a href='@Url.Action("Register","Account")'><i class="fa fa-plus-circle"></i>ADD</a>
                </li>
            </ol>

        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header bg-info">
                <h4 class="m-b-0 text-white">प्रयोगकर्ता</h4>
            </div>
            <div class="card-body">
                <div class="body_blocks top">

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover table-striped tablesorter plk-tble-width5">
                            <tr>
                                <th class="text-center">क्र.सं.</th>
                                <th><i class="fa fa-sort"></i> प्रयोगकर्ताको नाम </th>
                                <th><i class="fa fa-sort"></i> रोल </th>


                                <th><i class="fa fa-sort"></i> इस्टाटस </th>

                                <th><i class="fa fa-sort"></i> थपेको मिति </th>

                                <th width="40">Action</th>
                            </tr>
                            @foreach (var item in Model)
                            {
                                var role = item.UserRole.Name == "SuperAdmin" ? "SuperAdmin" : "Operator";
                                var status = "";
                                if (item.Status == 1)
                                {
                                    status = "Active";
                                }
                                else if (item.Status == 2)
                                {
                                    status = "Deleted";
                                }
                                SNo++;
                                <tr>
                                    <td class="text-center">@SNo</td>
                                    <td>@item.UserName</td>
                                    <td>@role</td>
                                   

                                    <td>@status</td>
                                    <td>@item.CreatedDate</td>

                                    <td style="white-space:nowrap">


                                        <a href="@Url.Action("Register", new { id = item.Id })"><i class="fa fa-edit"></i> </a>


                                        <a href="@Url.Action("delete", new { id = item.Id })" onclick="return confirm('Are you sure  want to delete??');"><i class="fa fa-trash-o"></i></a>





                                    </td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    if ($('.dropdown-menu').length < 4) {
        $('.dropdown-menu').addClass('dropdown-effect');
    }
</script>
